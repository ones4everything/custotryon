# ONES4 Print Designer - Environment Configuration

# Database
DATABASE_URI=mongodb://localhost:27017/ones4-print-designer

# Payload CMS
PAYLOAD_SECRET=your-payload-secret-key-here
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ONES4 Shopify Store
SHOPIFY_STORE_DOMAIN=jfg9tu-fb.myshopify.com
SHOPIFY_PUBLIC_DOMAIN=www.ones4.com
SHOPIFY_API_KEY=your-shopify-api-key-here
SHOPIFY_PASSWORD=your-shopify-password-here
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret-here

# Print Designer App
PRINT_DESIGNER_PATH=C:\Users\Noe\customization\print-designer
PRINT_DESIGNER_OUTPUT_DIR=C:\Users\Noe\customization\print-designer\output

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# AWS S3 (Optional for cloud storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key  
# AWS_REGION=us-east-1
# AWS_BUCKET=ones4-print-designs

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Development
NODE_ENV=development
PORT=3000

# Security
CORS_ORIGINS=https://www.ones4.com,https://jfg9tu-fb.myshopify.com,http://localhost:3000