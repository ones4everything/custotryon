{% comment %}
Futuristic Hub Menu — neon cube selector with live product grid
{% endcomment %}

<style>
#hub-{{ section.id }}{
  --neon-blue: rgba(90,240,255,.9);
  --neon-cyan: rgba(102,246,226,.9);
  --neon-green: rgba(123,255,178,.88);
  --neon-yellow: rgba(255,212,111,.9);
  --neon-pink: rgba(255,130,255,.9);
  --neon-red: rgba(255,107,107,.9);
  --surface: {{ section.settings.bg_color | default: '#05060a' }};
  --active-tone: var(--neon-blue);
  --glass: rgba(255,255,255,.06);
  --glass-strong: rgba(255,255,255,.14);
  --edge: rgba(255,255,255,.22);
  --text-strong: #eef3ff;
  --text-soft: #b7c5e8;
  --noise: radial-gradient(circle at 18% 20%, rgba(255,255,255,.05) 0 10%, transparent 16%), radial-gradient(circle at 78% 28%, rgba(255,255,255,.04) 0 9%, transparent 16%), radial-gradient(circle at 48% 72%, rgba(255,255,255,.03) 0 9%, transparent 16%);
  position:relative;
  overflow:hidden;
  color:var(--text-strong);
  background:
    radial-gradient(80% 70% at 18% 18%, rgba(117,255,255,.18), transparent 55%),
    radial-gradient(80% 70% at 82% 18%, rgba(255,128,214,.16), transparent 60%),
    radial-gradient(100% 90% at 50% 90%, rgba(93,124,255,.18), transparent 55%),
    linear-gradient(140deg, #070a14 0%, #050812 50%, #040711 100%),
    var(--surface);
  font-family:'Space Grotesk','Sora','Inter',system-ui,sans-serif;
  letter-spacing:0.02em;
  padding:92px 0 96px;
}
#hub-{{ section.id }}::before,
#hub-{{ section.id }}::after{
  content:'';
  position:absolute;
  inset:-10%;
  pointer-events:none;
  z-index:0;
}
#hub-{{ section.id }}::before{
  background:
    radial-gradient(45% 40% at 30% 60%, rgba(255,255,255,.08), transparent 50%),
    radial-gradient(42% 40% at 75% 48%, rgba(0,255,255,.08), transparent 50%),
    radial-gradient(60% 52% at 50% 10%, rgba(255,255,255,.05), transparent 58%);
  filter:blur(24px);
  opacity:.9;
}
#hub-{{ section.id }}::after{
  background-image:
    radial-gradient(70% 120% at 50% -10%, rgba(255,255,255,.06), transparent 60%),
    repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0, rgba(255,255,255,0) 4px, transparent 8px);
  mix-blend-mode:soft-light;
  opacity:.6;
}
#hub-{{ section.id }} .hub-gridlines{
  position:absolute;inset:0;z-index:1;pointer-events:none;
}
#hub-{{ section.id }} .hub-gridlines::before,
#hub-{{ section.id }} .hub-gridlines::after{
  content:'';position:absolute;inset:-10%;mix-blend-mode:screen;opacity:.4;
}
#hub-{{ section.id }} .hub-gridlines::before{
  background:
    linear-gradient(0deg, rgba(255,255,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size:140px 140px;
  filter:blur(0.5px);
}
#hub-{{ section.id }} .hub-gridlines::after{
  background:radial-gradient(70% 70% at 50% 40%, rgba(255,255,255,.08), transparent 60%),
             radial-gradient(60% 60% at 20% 20%, rgba(0,255,255,.1), transparent 60%),
             radial-gradient(70% 70% at 80% 80%, rgba(255,120,200,.1), transparent 60%);
  filter:blur(18px);
}
#hub-{{ section.id }} .hub-inner{position:relative;z-index:3;max-width:1280px;margin:0 auto;padding:0 22px;}
#hub-{{ section.id }} .hub-heading{
  text-align:center;
  margin-bottom:28px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
#hub-{{ section.id }} .hub-title{
  font-size:clamp(34px,5vw,66px);
  letter-spacing:0.08em;
  font-weight:800;
  text-transform:uppercase;
  background:linear-gradient(120deg, #f3fbff 0%, #9ce8ff 45%, #ffb5ff 85%);
  -webkit-background-clip:text;
  color:transparent;
  text-shadow:0 10px 30px rgba(0,0,0,.45),0 0 30px rgba(0,255,255,.18);
}
#hub-{{ section.id }} .hub-sub{
  font-size:0.98rem;
  color:var(--text-soft);
  text-transform:uppercase;
  letter-spacing:0.14em;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  padding:8px 14px;
  border-radius:999px;
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.07);
  box-shadow:-10px -10px 20px rgba(255,255,255,.02), 12px 16px 28px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.06), inset 0 -1px 10px rgba(0,0,0,.26);
  backdrop-filter:blur(12px) saturate(140%);
}
#hub-{{ section.id }} .hub-rail{
  display:flex;
  justify-content:center;
  align-items:flex-end;
  gap:16px;
  flex-wrap:wrap;
  padding:18px 16px 14px;
  position:relative;
  border-radius:22px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.08), rgba(255,255,255,.02)),
    var(--noise);
  background-blend-mode: screen, normal;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:-16px -16px 30px rgba(255,255,255,.03), 20px 28px 56px rgba(0,0,0,.65), inset 0 1px 0 rgba(255,255,255,.08), inset 0 -1px 14px rgba(0,0,0,.35);
  backdrop-filter:blur(18px) saturate(150%);
  overflow:hidden;
}
#hub-{{ section.id }} .hub-rail::after{
  content:'';
  position:absolute;
  inset:-30% -10%;
  background:radial-gradient(80% 80% at 50% 10%, rgba(255,255,255,.08), transparent 60%);
  opacity:.5;
  pointer-events:none;
}
#hub-{{ section.id }} .hub-cube{
  --tone: var(--active-tone);
  min-width:148px;
  padding:16px 16px 14px;
  border-radius:18px;
  position:relative;
  display:flex;align-items:center;justify-content:center;
  text-transform:uppercase;
  letter-spacing:.09em;
  font-weight:800;
  font-size:0.92rem;
  color:var(--text-strong);
  background:linear-gradient(160deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
  border:1px solid rgba(255,255,255,.08);
  box-shadow:-12px -12px 24px rgba(255,255,255,.02), 14px 16px 30px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.1), inset 0 -1px 12px rgba(0,0,0,.35);
  transition:transform .35s ease, box-shadow .35s ease, border-color .35s ease, color .35s ease, background .35s ease, opacity .35s ease;
  cursor:pointer;
  overflow:hidden;
  isolation:isolate;
  backdrop-filter:blur(14px) saturate(160%);
}
#hub-{{ section.id }} .hub-cube .cube-label{
  position:relative;
  z-index:3;
  text-shadow:0 8px 18px rgba(0,0,0,.45),0 0 14px rgba(255,255,255,.16);
}
#hub-{{ section.id }} .hub-cube .cube-dot{
  position:absolute;
  left:50%;
  bottom:8px;
  width:40px;
  height:4px;
  border-radius:999px;
  background:linear-gradient(90deg, transparent, var(--tone), transparent);
  box-shadow:0 0 12px var(--tone);
  transform:translate(-50%, 8px);
  opacity:0;
  transition:transform .28s ease, opacity .28s ease;
  z-index:3;
}
#hub-{{ section.id }} .hub-cube::before,
#hub-{{ section.id }} .hub-cube::after{
  content:'';position:absolute;inset:1px;border-radius:inherit;pointer-events:none;transition:opacity .35s ease;
}
#hub-{{ section.id }} .hub-cube::before{
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 0 26px rgba(255,255,255,.05) inset;
  opacity:.5;
}
#hub-{{ section.id }} .hub-cube::after{
  inset:-2px;
  border-radius:inherit;
  box-shadow:0 0 0 1px rgba(255,255,255,.04),0 0 28px var(--tone);
  opacity:.35;
}
#hub-{{ section.id }} .hub-cube.has-image{
  padding:0;
  background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.02));
  border-color:rgba(255,255,255,.16);
}
#hub-{{ section.id }} .hub-cube .cube-media{
  position:absolute;inset:0;
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  filter:saturate(1.05);
  transform:scale(1.02);
  transition:transform .35s ease, filter .35s ease, opacity .35s ease;
  z-index:0;
  opacity:.9;
}
#hub-{{ section.id }} .hub-cube .cube-mirror{
  position:absolute;inset:-4px;
  border-radius:20px;
  pointer-events:none;
  background:linear-gradient(115deg, rgba(255,255,255,.35), rgba(255,255,255,.05) 40%, rgba(255,255,255,.25));
  mix-blend-mode:overlay;
  opacity:.48;
  box-shadow:0 0 20px rgba(0,0,0,.35),0 0 32px var(--tone);
  z-index:2;
  transition:opacity .35s ease;
}
#hub-{{ section.id }} .hub-cube[data-color="blue"]{--tone:var(--neon-blue);}
#hub-{{ section.id }} .hub-cube[data-color="cyan"]{--tone:var(--neon-cyan);}
#hub-{{ section.id }} .hub-cube[data-color="green"]{--tone:var(--neon-green);}
#hub-{{ section.id }} .hub-cube[data-color="yellow"]{--tone:var(--neon-yellow);}
#hub-{{ section.id }} .hub-cube[data-color="pink"]{--tone:var(--neon-pink);}
#hub-{{ section.id }} .hub-cube[data-color="red"]{--tone:var(--neon-red);}
#hub-{{ section.id }} .hub-cube:hover,
#hub-{{ section.id }} .hub-cube.active{
  transform:translateY(-8px);
  border-color:rgba(255,255,255,.18);
  box-shadow:-10px -10px 22px rgba(255,255,255,.03), 20px 22px 52px rgba(0,0,0,.64), 0 0 34px var(--tone), 0 0 50px rgba(255,255,255,.08);
  color:#f7fbff;
  background:linear-gradient(160deg, rgba(255,255,255,.14), rgba(255,255,255,.05));
}
#hub-{{ section.id }} .hub-cube.active{
  box-shadow:-10px -10px 22px rgba(255,255,255,.03), 20px 22px 52px rgba(0,0,0,.64), 0 0 40px var(--tone), 0 0 60px var(--tone);
}
#hub-{{ section.id }} .hub-cube:hover .cube-media,
#hub-{{ section.id }} .hub-cube.active .cube-media{
  transform:scale(1.05);
  filter:saturate(1.2);
  opacity:1;
}
#hub-{{ section.id }} .hub-cube.active .cube-dot{
  transform:translate(-50%, -2px);
  opacity:.95;
}
#hub-{{ section.id }} .hub-cube.active::before{opacity:.75;}
#hub-{{ section.id }} .hub-cube.active::after{opacity:.78;}
#hub-{{ section.id }} .hub-cube:focus-visible{
  outline:2px solid var(--tone);
  outline-offset:3px;
}
#hub-{{ section.id }} .hub-stage{
  margin:44px auto 0;
  max-width:1180px;
  background:
    linear-gradient(140deg, rgba(255,255,255,.08), rgba(255,255,255,.01)),
    var(--noise);
  background-blend-mode: screen, normal;
  border:1px solid rgba(255,255,255,.08);
  border-radius:26px;
  padding:22px 22px 26px;
  box-shadow:-18px -18px 42px rgba(255,255,255,.02), 24px 30px 78px rgba(0,0,0,.68), inset 0 1px 0 rgba(255,255,255,.08), inset 0 -1px 18px rgba(0,0,0,.35);
  position:relative;
  overflow:hidden;
  backdrop-filter:blur(26px) saturate(160%);
}
#hub-{{ section.id }} .hub-stage::before,
#hub-{{ section.id }} .hub-stage::after{
  content:'';position:absolute;inset:-2px;border-radius:26px;pointer-events:none;
}
#hub-{{ section.id }} .hub-stage::before{
  background:none;
  opacity:0;
  filter:blur(0px);
}
#hub-{{ section.id }} .hub-stage::after{
  border:1px solid rgba(255,255,255,.08);
  box-shadow:0 0 36px rgba(255,255,255,.04) inset;
  opacity:.9;
}
#hub-{{ section.id }} .hub-stage-halo{
  position:absolute;inset:-1px;border-radius:26px;
  border:1px solid rgba(255,255,255,.04);
  box-shadow:none;
  opacity:0;
  pointer-events:none;
}
#hub-{{ section.id }} .hub-grid-wrap{
  position:relative;z-index:2;min-height:330px;
}
#hub-{{ section.id }} .hub-grid{
  display:none;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:18px;
  opacity:0;
}
#hub-{{ section.id }} .hub-grid.active{
  display:grid;
  animation:hub-rise .65s ease forwards;
}
#hub-{{ section.id }} .hub-card{
  position:relative;
  display:block;
  color:inherit;
  text-decoration:none;
  background:linear-gradient(165deg, rgba(255,255,255,.1), rgba(255,255,255,.02));
  border:1px solid rgba(255,255,255,.08);
  border-radius:20px;
  padding:14px 12px;
  overflow:hidden;
  box-shadow:-12px -12px 24px rgba(255,255,255,.02), 16px 20px 40px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08), inset 0 -1px 12px rgba(0,0,0,.34);
  transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease, background .3s ease;
  backdrop-filter:blur(14px) saturate(140%);
  clip-path:polygon(10% 0, 90% 0, 100% 10%, 100% 90%, 90% 100%, 10% 100%, 0 90%, 0 10%);
}
#hub-{{ section.id }} .hub-card::before{
  content:'';
  position:absolute;inset:1px;
  border-radius:20px;
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 0 32px rgba(255,255,255,.08) inset, 0 0 1px rgba(255,255,255,.1);
  pointer-events:none;
}
#hub-{{ section.id }} .hub-card::after{
  content:'';
  position:absolute;inset:-20%;
  background:radial-gradient(60% 70% at 20% 16%, rgba(255,255,255,.18), transparent 60%),
             radial-gradient(70% 70% at 80% 80%, var(--active-tone), transparent 70%);
  filter:blur(20px);
  opacity:0;
  transition:opacity .3s ease;
}
#hub-{{ section.id }} .hub-card:hover{
  transform:translateY(-6px);
  border-color:rgba(255,255,255,.16);
  box-shadow:-14px -14px 26px rgba(255,255,255,.03), 18px 24px 52px rgba(0,0,0,.62), 0 0 30px rgba(0,0,0,.2);
  background:linear-gradient(165deg, rgba(255,255,255,.16), rgba(255,255,255,.04));
}
#hub-{{ section.id }} .hub-card:hover::after{opacity:.45;}
#hub-{{ section.id }} .hub-card:focus-visible{
  outline:2px solid var(--active-tone);
  outline-offset:4px;
}
#hub-{{ section.id }} .hub-card img{
  width:100%;
  aspect-ratio:4/5;
  object-fit:cover;
  border-radius:14px;
  display:block;
  box-shadow:0 12px 32px rgba(0,0,0,.48),0 0 0 1px rgba(255,255,255,.05);
}
#hub-{{ section.id }} .hub-card .hub-card-body{
  margin-top:12px;
  display:flex;flex-direction:column;gap:6px;
  padding:0 8px;
}
#hub-{{ section.id }} .hub-card .title{
  font-size:1rem;
  font-weight:900;
  color:#f5f8ff;
  letter-spacing:.02em;
  text-shadow:0 4px 12px rgba(0,0,0,.6);
}
#hub-{{ section.id }} .hub-card .price{
  font-size:1.1rem;
  font-weight:900;
  background:linear-gradient(120deg, var(--neon-blue), var(--neon-cyan));
  -webkit-background-clip:text;
  color:transparent;
  letter-spacing:.05em;
  text-shadow:0 0 16px rgba(90,240,255,.4);
  filter:drop-shadow(0 0 8px rgba(90,240,255,.3));
}
#hub-{{ section.id }} .hub-empty{
  text-align:center;
  color:var(--text-soft);
  padding:32px 12px;
  font-size:0.98rem;
  background:rgba(255,255,255,.03);
  border:1px dashed rgba(255,255,255,.12);
  border-radius:18px;
  box-shadow:-10px -10px 20px rgba(255,255,255,.02), 12px 16px 26px rgba(0,0,0,.45);
}
#hub-{{ section.id }} .hub-card-actions{
  margin-top:auto;
  display:flex;
  gap:8px;
}
#hub-{{ section.id }} .hub-card-btn{
  flex:1;
  padding:10px 14px;
  border-radius:10px;
  border:1.5px solid var(--active-tone);
  background:linear-gradient(120deg, var(--active-tone), rgba(90,240,255,.6));
  color:#041017;
  font-weight:900;
  font-size:0.85rem;
  text-transform:uppercase;
  letter-spacing:.08em;
  cursor:pointer;
  transition:all .2s ease;
  box-shadow:0 8px 16px rgba(90,240,255,.3), inset 0 1px 0 rgba(255,255,255,.3);
  text-shadow:0 2px 4px rgba(0,0,0,.2);
  position:relative;
  overflow:hidden;
}
#hub-{{ section.id }} .hub-card-btn::before{
  content:'';
  position:absolute;
  inset:0;
  background:radial-gradient(circle at center, rgba(255,255,255,.4), transparent 70%);
  opacity:0;
  transition:opacity .2s ease;
}
#hub-{{ section.id }} .hub-card-btn:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 24px rgba(90,240,255,.4), 0 0 20px var(--active-tone), inset 0 1px 0 rgba(255,255,255,.4);
  background:linear-gradient(120deg, var(--active-tone), rgba(102,246,226,.6));
}
#hub-{{ section.id }} .hub-card-btn:hover::before{
  opacity:1;
}
#hub-{{ section.id }} .hub-card-btn:active{
  transform:translateY(-1px);
  box-shadow:0 6px 12px rgba(90,240,255,.3), inset 0 2px 4px rgba(0,0,0,.2);
}
@keyframes pulse-glow{
  0%, 100%{opacity:1;}
  50%{opacity:.7;}
}
#hub-{{ section.id }} .hub-cube.active{
  animation:pulse-glow 2s ease-in-out infinite;
}
@keyframes hub-rise{
  from{opacity:0;transform:translateY(14px);}
  to{opacity:1;transform:translateY(0);}
}
@keyframes hub-glow-pulse{
  0%{opacity:.55;}
  50%{opacity:.62;}
  100%{opacity:.55;}
}
@media(max-width:900px){
  #hub-{{ section.id }}{padding:76px 0 84px;}
  #hub-{{ section.id }} .hub-cube{min-width:124px;}
  #hub-{{ section.id }} .hub-title{letter-spacing:0.06em;}
  #hub-{{ section.id }} .hub-cube .cube-mirror{opacity:.52;}
}
@media(max-width:640px){
  #hub-{{ section.id }} .hub-rail{gap:12px;padding:14px 12px;}
  #hub-{{ section.id }} .hub-cube{min-width:110px;font-size:.82rem;border-radius:14px;}
  #hub-{{ section.id }} .hub-cube .cube-mirror{opacity:.56;}
  #hub-{{ section.id }} .hub-stage{padding:16px;}
  #hub-{{ section.id }} .hub-grid{gap:14px;}
}
@media(max-width:420px){
  #hub-{{ section.id }}{padding:50px 0 54px;}
  #hub-{{ section.id }} .hub-cube{min-width:96px;height:90px;font-size:.76rem;letter-spacing:.06em;}
  #hub-{{ section.id }} .hub-title{letter-spacing:0.05em;}
  #hub-{{ section.id }} .hub-stage{padding:12px;border-radius:20px;}
  #hub-{{ section.id }} .hub-grid{gap:12px;}
}
@media (prefers-reduced-motion: reduce){
  #hub-{{ section.id }} *{animation:none !important;transition:none !important;}
}
</style>

<section id="hub-{{ section.id }}">
  {% assign products_limit = section.settings.products_limit | default: 8 %}
  <div class="hub-gridlines" aria-hidden="true"></div>
  <div class="hub-inner">
    <div class="hub-heading">
      <div class="hub-title">{{ section.settings.heading | escape }}</div>
      <div class="hub-sub">Select your drop</div>
    </div>

    <div class="hub-rail" role="tablist">
      {% for block in section.blocks %}
        <button type="button"
          class="hub-cube {% if block.settings.custom_icon %}has-image{% endif %}"
          role="tab"
          data-target="hub-cat-{{ section.id }}-{{ forloop.index }}"
          data-color="{{ block.settings.color_scheme | escape }}"
          aria-controls="hub-cat-{{ section.id }}-{{ forloop.index }}">
          {% if block.settings.custom_icon %}
            <span class="cube-media" aria-hidden="true" style="background-image:url('{{ block.settings.custom_icon | image_url: width: 600 }}');"></span>
            <span class="cube-mirror" aria-hidden="true"></span>
          {% endif %}
          <span class="cube-label">{{ block.settings.title }}</span>
          <span class="cube-dot" aria-hidden="true"></span>
        </button>
      {% endfor %}
    </div>

    <div class="hub-stage" role="tabpanel">
      <div class="hub-stage-halo" aria-hidden="true"></div>
      <div class="hub-grid-wrap">
        {% for block in section.blocks %}
          {% assign selected_collection = collections[block.settings.collection] %}
          <div class="hub-grid" id="hub-cat-{{ section.id }}-{{ forloop.index }}">
            {% if selected_collection != blank and selected_collection.products_count > 0 %}
              {% for product in selected_collection.products limit: products_limit %}
                <a class="hub-card" href="{{ product.url | within: selected_collection }}" aria-label="{{ product.title | escape }}">
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}">
                  <div class="hub-card-body">
                    <div class="title">{{ product.title }}</div>
                    <div class="price">{{ product.price | money }}</div>
                  </div>
                </a>
              {% endfor %}
            {% else %}
              <div class="hub-empty">Add a collection in the theme editor to showcase products for {{ block.settings.title }}.</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var hub = document.getElementById('hub-{{ section.id }}');
  if (!hub) return;
  var triggers = Array.from(hub.querySelectorAll('[data-target]'));
  var grids = Array.from(hub.querySelectorAll('.hub-grid'));

  function colorFor(key){
    var map = {
      blue: 'var(--neon-blue)',
      cyan: 'var(--neon-cyan)',
      green: 'var(--neon-green)',
      yellow: 'var(--neon-yellow)',
      pink: 'var(--neon-pink)',
      red: 'var(--neon-red)'
    };
    return map[key] || 'var(--neon-blue)';
  }

  function activate(id, colorKey){
    grids.forEach(function(grid){
      grid.classList.toggle('active', grid.id === id);
      if (grid.classList.contains('active')){
        grid.setAttribute('aria-hidden','false');
      } else {
        grid.setAttribute('aria-hidden','true');
      }
    });
    triggers.forEach(function(btn){
      var on = btn.dataset.target === id;
      btn.classList.toggle('active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    hub.style.setProperty('--active-tone', colorFor(colorKey));
  }

  var initial = triggers[0];
  var initialId = initial ? initial.dataset.target : null;
  var initialColor = initial ? initial.dataset.color : 'blue';
  if (initialId){
    activate(initialId, initialColor);
  }

  hub.addEventListener('click', function(e){
    var btn = e.target.closest('[data-target]');
    if (!btn || !hub.contains(btn)) return;
    activate(btn.dataset.target, btn.dataset.color);
  });
});
</script>

