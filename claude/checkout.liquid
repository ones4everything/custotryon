<!-- Ones4 Neon Checkout Landing (with Hover Preview) -->
<section class="o4-checkout-wrap">
  <div class="o4-bg">
    <div class="o4-bokeh o4-b1"></div>
    <div class="o4-bokeh o4-b2"></div>
    <div class="o4-bokeh o4-b3"></div>
  </div>

  <div class="o4-shell">
    <header class=" o4-head">
      <div class="o4-kicker">Category</div>
      <h1 class="o4-title">Smart  Checkout</h1>
      <p class="o4-sub">Everything your way</p>
    </header>

    <div class="o4-grid">
      <!-- LEFT: Preview + Notes -->
      <aside class="o4-pane">
        <!-- BIG HOVER PREVIEW -->
        <div class="o4-card o4-preview" id="o4PrevCard" data-empty="1" aria-live="polite">
          <div class="o4-card-head">
            <span class="o4-dot"></span>
            <h2 class="o4-card-title">Preview</h2>
          </div>

          <div class="o4-prev-media">
            <img id="o4PrevImg" alt="" width="900" height="700">
            <span class="o4-prev-frame"></span>
            <span class="o4-prev-scan"></span>
          </div>

          <div class="o4-prev-info">
            <div id="o4PrevTitle" class="o4-prev-title">Hover an item -></div>
            <div class="o4-prev-price" id="o4PrevPrice"></div>

            <div class="o4-actions">
              <a id="o4PrevLink" class="o4-btn glow" href="#" style="display:none">Open product</a>
            </div>
          </div>
        </div>

        <!-- NOTES -->
        <div class="o4-card">
          <div class="o4-card-head">
            <span class="o4-dot"></span>
            <h2 class="o4-card-title">Customer Notes</h2>
          </div>

          <form class="o4-form" action="{{ routes.cart_url }}" method="post">
            <label class="o4-label" for="o4CartNote">Order note</label>
            <textarea id="o4CartNote" name="note" rows="4" class="o4-input" placeholder="Gift message, delivery notes">{{ cart.note | escape }}</textarea>

            <div class="o4-divider"></div>
            <div class="o4-hint">Secure checkout handled by Shopify.</div>

            <div class="o4-actions">
              <button class="o4-btn ghost" type="submit" name="update">Update cart</button>
              <button class="o4-btn glow" type="submit" name="checkout">Proceed to checkout</button>
            </div>
          </form>
        </div>

        <div class="o4-card o4-mini">
          <div class="o4-card-head">
            <span class="o4-dot"></span>
            <h3 class="o4-card-title">Need help?</h3>
          </div>
          <p class="o4-help">Chat with us or email <a href="mailto:support@{{ shop.domain }}" class="o4-link">support@{{ shop.domain }}</a></p>
        </div>
      </aside>

      <!-- RIGHT: Order summary -->
      <main class="o4-pane">
        <div class="o4-card">
          <div class="o4-card-head">
            <span class="o4-dot"></span>
            <h2 class="o4-card-title">Order Summary</h2>
          </div>

          {% assign item_count = cart.item_count | plus: 0 %}
          {% if item_count > 0 %}
            <form action="{{ routes.cart_url }}" method="post">
              <ul class="o4-lines" role="list" id="o4LineList">
                {% for item in cart.items %}
                  {% assign line_img = '' %}
                  {% if item.image %}
                    {% assign line_img = item.image | image_url: width: 1200 %}
                  {% endif %}

                  <li class="o4-line"
                      tabindex="0"
                      data-title="{{ item.product.title | escape }}"
                      data-price="{{ item.final_line_price | money }}"
                      data-url="{{ item.url }}"
                      data-img="{{ line_img }}">
                    <div class="o4-thumb">
                      {% if item.image %}
                        <img
                          src="{{ item.image | image_url: width: 240 }}"
                          alt="{{ item.image.alt | escape | default: item.product.title | escape }}"
                          width="{{ item.image.width }}"
                          height="{{ item.image.height }}"
                          loading="lazy">
                      {% else %}
                        <div class="o4-ph">No image</div>
                      {% endif %}
                      <span class="o4-frame"></span>
                      <span class="o4-scan"></span>
                    </div>

                    <div class="o4-meta">
                      <a href="{{ item.url }}" class="o4-line-title">{{ item.product.title }}</a>
                      {% if item.variant and item.product.has_only_default_variant == false %}
                        <div class="o4-variant">{{ item.variant.title }}</div>
                      {% endif %}

                      <div class="o4-qty">
                        <label for="updates_{{ item.key }}" class="sr-only">Quantity</label>
                        <button class="o4-step" type="submit" name="updates[{{ item.key }}]" value="{{ item.quantity | minus: 1 | at_least: 0 }}" aria-label="Decrease">-</button>
                        <input id="updates_{{ item.key }}" class="o4-qty-input" name="updates[{{ item.key }}]" value="{{ item.quantity }}" inputmode="numeric" pattern="[0-9]*" aria-label="Quantity">
                        <button class="o4-step" type="submit" name="updates[{{ item.key }}]" value="{{ item.quantity | plus: 1 }}" aria-label="Increase">+</button>
                      </div>
                    </div>

                    <div class="o4-amt">
                      <div class="o4-price">{{ item.final_line_price | money }}</div>
                      {% if item.original_line_price > item.final_line_price %}
                        <div class="o4-compare">{{ item.original_line_price | money }}</div>
                      {% endif %}
                      <button class="o4-remove" type="submit" name="updates[{{ item.key }}]" value="0" aria-label="Remove">Remove</button>
                    </div>
                  </li>
                {% endfor %}
              </ul>

              <div class="o4-totals">
                <div class="o4-row">
                  <span>Subtotal</span>
                  <strong>{{ cart.items_subtotal_price | money }}</strong>
                </div>

                {% assign discount_total = cart.total_discount | plus: 0 %}
                {% if discount_total > 0 %}
                  <div class="o4-row small">
                    <span>Discounts</span>
                    <span>- {{ discount_total | money }}</span>
                  </div>
                {% endif %}

                <div class="o4-row small">
                  <span>Shipping</span>
                  <span>Calculated at next step</span>
                </div>

                <div class="o4-divider"></div>

                <div class="o4-row total">
                  <span>Total</span>
                  <strong>{{ cart.total_price | money }}</strong>
                </div>
              </div>

              <div class="o4-actions stick">
                <button class="o4-btn ghost" type="submit" name="update">Update cart</button>
                <button class="o4-btn glow" type="submit" name="checkout">Proceed to checkout</button>
              </div>
            </form>
          {% else %}
            <div class="o4-empty">
              <p>Your cart is empty.</p>
              <a class="o4-btn glow" href="{{ routes.all_products_collection_url }}">Start shopping</a>
            </div>
          {% endif %}
        </div>
      </main>
    </div>
  </div>
</section>

<style>
/* ---------- Base / backdrop ---------- */
.o4-checkout-wrap{position:relative;isolation:isolate;background:#0b0f17;padding:28px 16px;color:#E9ECFF}
.o4-bg{position:absolute;inset:0;overflow:hidden;z-index:-1;filter:blur(10px)}
.o4-bokeh{position:absolute;border-radius:9999px;opacity:.4;filter:blur(40px)}
.o4-b1{width:420px;height:420px;left:-80px;top:-60px;background:#6EE0FF33}
.o4-b2{width:520px;height:520px;right:-120px;top:10%;background:#B98AFF33}
.o4-b3{width:360px;height:360px;left:20%;bottom:-120px;background:#6ef0ff2b}

.o4-shell{max-width:1200px;margin:0 auto}
.o4-head{text-align:left;margin-bottom:20px}
.o4-kicker{font:700 12px/1 Inter,system-ui,sans-serif;opacity:.8;margin-bottom:6px}
.o4-title{font:800 30px/1.1 Inter,system-ui,sans-serif;text-shadow:0 0 24px #6EE0FF66, 0 0 36px #B98AFF55}
.o4-sub{opacity:.75;margin-top:8px}

.o4-grid{display:grid;grid-template-columns:380px 1fr;gap:16px}
@media (max-width: 980px){.o4-grid{grid-template-columns:1fr}}

.o4-pane{min-width:0}
.o4-card{background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.13);border-radius:16px;box-shadow:inset 0 0 24px #b98aff14, 0 20px 60px #0008;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:14px}
.o4-mini{margin-top:14px}
.o4-card-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.o4-card-title{font:800 15px/1 Inter,system-ui,sans-serif}
.o4-dot{width:8px;height:8px;border-radius:9999px;background:linear-gradient(90deg,#6EE0FF,#B98AFF);box-shadow:0 0 14px #6EE0FF}

/* --- Preview --- */
.o4-preview[data-empty="1"] .o4-prev-media img{display:none}
.o4-prev-media{position:relative;aspect-ratio:4/3;border-radius:14px;overflow:hidden;background:#0e1222;margin-bottom:10px}
.o4-prev-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.o4-prev-frame{position:absolute;inset:0;border-radius:14px;border:1px solid #6EE0FF66;box-shadow:inset 0 0 0 1px #B98AFF44}
.o4-prev-scan{position:absolute;left:-30%;top:0;width:60%;height:100%;background:linear-gradient(115deg,transparent 20%,#ffffff22 45%,transparent 65%);animation:o4Sweep 5s linear infinite;transform:rotate(2deg)}
.o4-prev-title{font:800 16px/1.2 Inter,sans-serif;margin-bottom:6px}
.o4-prev-price{font:800 15px/1 Inter;margin-bottom:10px}

@keyframes o4Sweep{0%{left:-30%}100%{left:130%}}

.o4-form{display:flex;flex-direction:column;gap:10px}
.o4-label{font:600 12px/1 Inter,system-ui,sans-serif;opacity:.9}
.o4-input{width:100%;border-radius:12px;border:1px solid rgba(255,255,255,.18);background:rgba(5,10,18,.6);color:#E9ECFF;padding:10px;resize:vertical;outline:none;box-shadow:inset 0 0 0 9999px rgba(255,255,255,.03)}
.o4-input:focus{border-color:#6EE0FF99;box-shadow:0 0 0 3px #6EE0FF55}

.o4-divider{height:1px;background:linear-gradient(90deg,transparent,#ffffff2a,transparent);margin:8px 0}
.o4-hint{font-size:12px;opacity:.75}
.o4-actions{display:flex;gap:10px;flex-wrap:wrap}
.o4-actions.stick{position:sticky;bottom:0;padding-top:12px;background:linear-gradient(180deg,transparent,rgba(5,10,18,.55))}
.o4-btn{display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 16px;border-radius:12px;border:1px solid rgba(255,255,255,.18);font:800 13px/1 Inter,sans-serif;cursor:pointer;transition:transform .15s ease, box-shadow .15s ease}
.o4-btn.ghost{background:rgba(255,255,255,.06);color:#E9ECFF}
.o4-btn.glow{background:linear-gradient(90deg,#6EE0FF,#B98AFF);color:#071018;box-shadow:0 0 24px #6EE0FF66}
.o4-btn:hover{transform:translateY(-1px)}
.o4-link{color:#6EE0FF;text-decoration:none}
.o4-help{opacity:.85}

/* ---------- Lines ---------- */
.o4-lines{display:flex;flex-direction:column;gap:12px;margin:0;padding:0;list-style:none}
.o4-line{display:grid;grid-template-columns:108px 1fr auto;gap:12px;align-items:center;border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:10px;background:rgba(5,10,18,.45);position:relative;overflow:hidden}
.o4-line:focus{outline:2px solid #6EE0FF88;outline-offset:2px}
@media (max-width: 640px){.o4-line{grid-template-columns:80px 1fr;grid-auto-rows:auto}.o4-amt{grid-column:1 / -1;display:flex;justify-content:space-between;align-items:center}}

.o4-thumb{position:relative;border-radius:12px;overflow:hidden;isolation:isolate}
.o4-thumb img{display:block;width:100%;height:auto;border-radius:12px}
.o4-ph{width:100%;aspect-ratio:1/1;border-radius:12px;background:#0f1726;display:grid;place-items:center;color:#99a}
.o4-frame{position:absolute;inset:0;border-radius:12px;border:1px solid #6EE0FF55;box-shadow:inset 0 0 0 1px #B98AFF33;pointer-events:none}
.o4-scan{position:absolute;left:-30%;top:0;width:60%;height:100%;background:linear-gradient(115deg,transparent 20%,#ffffff22 45%,transparent 65%);transform:translateX(0) rotate(3deg);animation:o4Sweep 4s linear infinite}

@media (max-width: 640px){
  .o4-bg{filter:blur(4px)}
  .o4-bokeh{filter:blur(24px);opacity:.3}
  .o4-card{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
}

.o4-meta{min-width:0}
.o4-line-title{font:700 14px/1.2 Inter,sans-serif;color:#E9ECFF;text-decoration:none}
.o4-variant{font:600 12px/1 Inter,sans-serif;opacity:.7;margin-top:4px}

.o4-qty{display:inline-flex;align-items:center;gap:6px;margin-top:10px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:10px;padding:4px}
.o4-step{height:28px;width:28px;border-radius:8px;border:1px solid rgba(255,255,255,.18);background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.04));color:#E9ECFF;font-weight:800;cursor:pointer}
.o4-qty-input{width:44px;text-align:center;border:none;background:transparent;color:#E9ECFF;font-weight:800;outline:none}

.o4-amt{text-align:right}
.o4-price{font:800 14px/1 Inter}
.o4-compare{font:700 12px/1 Inter;text-decoration:line-through;opacity:.6}
.o4-remove{margin-top:6px;background:transparent;border:none;color:#9fbfff;cursor:pointer;text-decoration:underline;font:700 12px/1 Inter}

@media (prefers-reduced-motion: reduce){
  .o4-prev-scan,
  .o4-scan{
    animation:none;
  }
  .o4-btn,
  .o4-line,
  .o4-card{
    transition:none;
  }
}

/* a11y */
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const list = document.getElementById('o4LineList');
  const card = document.getElementById('o4PrevCard');
  const img = document.getElementById('o4PrevImg');
  const title = document.getElementById('o4PrevTitle');
  const price = document.getElementById('o4PrevPrice');
  const link = document.getElementById('o4PrevLink');

  function setPreviewFromLine(li){
    if(!li) return;
    const src = li.dataset.img || '';
    const t = li.dataset.title || '';
    const p = li.dataset.price || '';
    const u = li.dataset.url || '#';

    if(src){
      img.src = src; img.alt = t; card.dataset.empty = '0';
    }else{
      img.removeAttribute('src'); img.alt = ''; card.dataset.empty = '1';
    }
    title.textContent = t || 'Hover an item ->';
    price.textContent = p || '';
    if(u && u !== '#'){ link.href = u; link.style.display = 'inline-flex'; } else { link.style.display = 'none'; }
  }

  function bindLines(){
    const lines = list?.querySelectorAll('.o4-line') || [];
    lines.forEach(li => {
      li.addEventListener('mouseenter', () => setPreviewFromLine(li));
      li.addEventListener('focusin', () => setPreviewFromLine(li));
    });
    // initial fill
    setPreviewFromLine(lines[0]);
  }

  bindLines();
});
</script>

{% schema %}
{
  "name": "Neon Checkout",
  "settings": [],
  "presets": [{ "name": "Neon Checkout" }]
}
{% endschema %}
