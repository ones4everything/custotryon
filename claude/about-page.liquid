<style>
#about-{{ section.id }} {
  --bg-1: #05070f;
  --bg-2: #0a0f1f;
  --glass: rgba(255, 255, 255, 0.06);
  --stroke: rgba(255, 255, 255, 0.12);
  --ink-strong: #f5fbff;
  --ink-soft: #c9d7f4;
  --accent: #7eeaff;
  --accent-2: #c77dff;
  font-family: 'Space Grotesk', 'Sora', 'Inter', system-ui, -apple-system, sans-serif;
  position: relative;
  color: var(--ink-strong);
  background:
    radial-gradient(90% 70% at 15% 18%, rgba(126, 234, 255, 0.12), transparent 50%),
    radial-gradient(90% 70% at 85% 18%, rgba(199, 125, 255, 0.12), transparent 52%),
    radial-gradient(110% 90% at 50% 90%, rgba(110, 146, 255, 0.15), transparent 55%),
    linear-gradient(140deg, var(--bg-1) 0%, #060813 45%, #04060d 100%);
  padding: 72px 0 96px;
  overflow: hidden;
}

#about-{{ section.id }} * { box-sizing: border-box; }

#about-{{ section.id }} .o-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}

#about-{{ section.id }} .o-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}

@media (min-width: 992px) {
  #about-{{ section.id }} .o-grid {
    grid-template-columns: 1.2fr 0.8fr;
  }
}

#about-{{ section.id }} .o-hero {
  background: var(--glass);
  border: 1px solid var(--stroke);
  border-radius: 22px;
  padding: 28px 24px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(16px);
}

#about-{{ section.id }} .o-kicker {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(126, 234, 255, 0.08);
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.8rem;
}

#about-{{ section.id }} .o-kicker .dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 12px var(--accent);
}

#about-{{ section.id }} .o-title {
  margin: 18px 0 12px;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
}

#about-{{ section.id }} .o-sub {
  margin: 0 0 18px;
  color: var(--ink-soft);
  font-size: 1.05rem;
  line-height: 1.6;
}

#about-{{ section.id }} .o-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  border-radius: 14px;
  border: 1px solid rgba(126, 234, 255, 0.25);
  background: linear-gradient(120deg, rgba(126, 234, 255, 0.2), rgba(199, 125, 255, 0.18));
  color: var(--ink-strong);
  text-decoration: none;
  font-weight: 700;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

#about-{{ section.id }} .o-cta svg { width: 18px; height: 18px; }

#about-{{ section.id }} .o-panel {
  background: var(--glass);
  border: 1px solid var(--stroke);
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35);
}

#about-{{ section.id }} .o-panel h3 {
  margin: 0 0 12px;
  font-size: 1.2rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

#about-{{ section.id }} .o-stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 14px;
  margin-top: 14px;
}

#about-{{ section.id }} .o-stat {
  padding: 14px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
}

#about-{{ section.id }} .o-stat .value {
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--accent);
}

#about-{{ section.id }} .o-stat .label {
  color: var(--ink-soft);
  font-size: 0.95rem;
  margin-top: 4px;
}

#about-{{ section.id }} .o-pillars {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

#about-{{ section.id }} .o-pillar {
  padding: 18px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
}

#about-{{ section.id }} .o-pillar h4 {
  margin: 0 0 8px;
  font-size: 1.05rem;
  color: var(--accent);
}

#about-{{ section.id }} .o-pillar p {
  margin: 0;
  color: var(--ink-soft);
  line-height: 1.5;
}

#about-{{ section.id }} .o-image {
  position: relative;
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid var(--stroke);
  min-height: 220px;
  background: linear-gradient(135deg, rgba(126, 234, 255, 0.12), rgba(199, 125, 255, 0.12));
}

#about-{{ section.id }} .o-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

@media (max-width: 640px) {
  #about-{{ section.id }} {
    padding: 56px 0 80px;
  }
  #about-{{ section.id }} .o-hero,
  #about-{{ section.id }} .o-panel {
    padding: 20px;
  }
  #about-{{ section.id }} .o-title { font-size: clamp(1.8rem, 7vw, 2.4rem); }
}

@media (prefers-reduced-motion: reduce) {
  #about-{{ section.id }} * {
    transition: none !important;
    animation: none !important;
  }
}
</style>

<section id="about-{{ section.id }}">
  <div class="o-shell">
    <div class="o-grid">
      <div class="o-hero">
        {% if section.settings.kicker != blank %}
          <div class="o-kicker"><span class="dot"></span>{{ section.settings.kicker }}</div>
        {% endif %}
        <h2 class="o-title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="o-sub">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <a class="o-cta" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="m13 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="o-panel">
        <h3>{{ section.settings.side_title }}</h3>
        {% if section.settings.side_body != blank %}
          <p style="margin:0 0 14px;color:var(--ink-soft);line-height:1.6;">{{ section.settings.side_body }}</p>
        {% endif %}
        <div class="o-stat-grid">
          {% for block in section.blocks %}
            {% if block.type == 'stat' %}
              <div class="o-stat">
                <div class="value">{{ block.settings.value }}</div>
                <div class="label">{{ block.settings.label }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div style="margin-top:28px; display:grid; gap:18px;">
      <div class="o-panel">
        <h3>{{ section.settings.pillars_title }}</h3>
        <div class="o-pillars">
          {% for block in section.blocks %}
            {% if block.type == 'pillar' %}
              <div class="o-pillar">
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.body }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if section.settings.image != blank %}
        <div class="o-image">
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "O4 About Page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Ones4 Collective" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the bold." },
    { "type": "textarea", "id": "subheading", "label": "Intro", "default": "Ones4 blends futuristic aesthetics with performance-ready essentials so you can move, create, and stand out." },
    { "type": "text", "id": "cta_label", "label": "CTA Label", "default": "Shop the drop" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" },
    { "type": "text", "id": "side_title", "label": "Side panel title", "default": "In the details" },
    { "type": "textarea", "id": "side_body", "label": "Side panel copy", "default": "Every piece we launch is tuned for longevity, comfort, and a distinct neon edge." },
    { "type": "text", "id": "pillars_title", "label": "Pillars title", "default": "What drives us" },
    { "type": "image_picker", "id": "image", "label": "Feature image" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "24/7" },
        { "type": "text", "id": "label", "label": "Label", "default": "Support ready" }
      ]
    },
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Design with intent" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Clean silhouettes, luminous finishes, and purposeful materials." }
      ]
    }
  ],
  "presets": [
    {
      "name": "O4 About Page",
      "blocks": [
        { "type": "stat", "settings": { "value": "10k+", "label": "Customers served" } },
        { "type": "stat", "settings": { "value": "50+", "label": "Drops delivered" } },
        { "type": "pillar", "settings": { "title": "Future-forward", "body": "We build for what comes next, not what’s already here." } },
        { "type": "pillar", "settings": { "title": "Performance fit", "body": "Comfort, durability, and freedom of movement in every piece." } }
      ]
    }
  ]
}
{% endschema %}
