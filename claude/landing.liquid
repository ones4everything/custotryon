}

#o4-hero-wrapper-{{ section.id }} .o4-hero__actions{
  justify-content: center;
}

#o4-hero-wrapper-{{ section.id }} .o4-hero__meta{
  margin-top: 20px;
}

.o4-hero-bg{position:absolute; inset:0; z-index:0; pointer-events:none; display:block; contain:paint}
.o4-hero-bg picture{position:absolute; inset:0; width:100%; height:100%; display:block}
.o4-hero-bg video,
.o4-hero-bg img{width:100%; height:100%; object-fit:cover; object-position:center 40%}
.o4-hero-bg img{filter:brightness(.95) saturate(1)}
.o4-hero-bg video{filter:brightness(.92) saturate(1.05)}

.o4-bg-mark{position:absolute; inset:0; display:flex; align-items:center; justify-content:center; z-index:1; pointer-events:none; opacity:.24; mix-blend-mode:screen}
.o4-bg-mark .mark{
  font-family:'Audiowide','Orbitron',system-ui,sans-serif; font-weight:800; letter-spacing:.06em; line-height:1;
  font-size:clamp(120px, 26vw, 520px);
  -webkit-text-fill-color: transparent;
  background-clip:text; -webkit-background-clip:text;
  -webkit-text-stroke: 6px rgba(255,255,255,.95);
  text-shadow: 0 0 8px rgba(255,255,255,.95), 0 0 18px rgba(255,255,255,.85);
}
.o4-bg-mark .mark-word{
  -webkit-text-fill-color: transparent; background-clip:text; -webkit-background-clip:text;
  background-image:
    radial-gradient(45% 60% at 50% 55%, #ffffff 0 28%, rgba(255,255,255,.8) 44%, transparent 48%),
    linear-gradient(180deg, #FFB9FF 0%, #FF2FB9 48%, #C100FF 100%);
  text-shadow:
    0 0 12px  #fff,
    0 0 34px  rgba(255,47,185,.95),
    0 0 90px  rgba(255,47,185,.80),
    0 0 170px rgba(193,0,255,.65),
    0 0 280px rgba(193,0,255,.55);
}
.o4-bg-mark .mark-digit{
  -webkit-text-fill-color: transparent; background-clip:text; -webkit-background-clip:text;
  background-image:
    radial-gradient(45% 60% at 50% 55%, #ffffff 0 28%, rgba(255,255,255,.8) 44%, transparent 48%),
    linear-gradient(180deg, #CFFFFF 0%, #04D9FF 48%, #00B6D4 100%);
  text-shadow:
    0 0 12px  #fff,
    0 0 34px  rgba(4,217,255,.98),
    0 0 90px  rgba(4,217,255,.85),
    0 0 170px rgba(0,182,212,.70),
    0 0 280px rgba(0,182,212,.55);
}
@media (max-width:767px){
  .o4-bg-mark{ opacity:.20; }
  .o4-bg-mark .mark{ -webkit-text-stroke-width:4px; }
  .neon-word,
  .neon-digit{ -webkit-text-stroke: 1.5px rgba(255,255,255,0.85); }
}

.o4-motion{position:absolute; inset:0; z-index:0; pointer-events:none; contain:paint}
.o4-motion .m-layer{position:absolute; inset:0}
.o4-motion .base{background-image:var(--bg); background-size:cover; background-position:center; filter:saturate(1.02) contrast(1.04)}
.o4-motion .parallax{background-image:var(--bg); background-size:102% 102%; background-position:center; opacity:.58; transform:scale(1.02); mix-blend-mode:screen; animation:o4-pan var(--spd,24s) ease-in-out infinite alternate}
.o4-motion .streaks{--mint:4,217,255; opacity:calc(.28*var(--int,.3)); mix-blend-mode:screen; background:
  repeating-linear-gradient(62deg, rgba(var(--mint),.06) 0 2px, transparent 2px 120px),
  repeating-linear-gradient(-28deg, rgba(var(--mint),.04) 0 1px, transparent 1px 140px);
  background-size:200% 200%,180% 180%;
  animation:o4-drift-a calc(var(--spd,24s)*1.2) linear infinite, o4-drift-b calc(var(--spd,24s)*1.6) linear infinite}
.o4-motion .veil{opacity:calc(.24*var(--int,.3)); background:
  radial-gradient(60% 60% at 55% 50%, rgba(4,217,255,.10), transparent 60%),
  radial-gradient(40% 40% at 35% 60%, rgba(4,217,255,.07), transparent 70%);
  animation:o4-breathe calc(var(--spd,24s)*1.4) ease-in-out infinite}

@keyframes o4-pan{from{transform:translate3d(-1.2%, -0.6%, 0) scale(1.04)} to{transform:translate3d(1.2%, 0.6%, 0) scale(1.06)}}
@keyframes o4-drift-a{from{background-position:0% 0%} to{background-position:100% 100%}}
@keyframes o4-drift-b{from{background-position:100% 0%} to{background-position:0% 100%}}
@keyframes o4-breathe{0%,100%{filter:blur(.4px)} 50%{filter:blur(1.1px)}}

.o4-orb, .o4-orbfx{position:absolute; inset:0; width:100%; height:100%; display:block; pointer-events:none; contain:paint}
.o4-orb{ z-index:1 }
.o4-orbfx{ z-index:2 }

.mint-orbits{position:absolute; inset:0; z-index:3; pointer-events:none; contain:paint}
.mint-orbits .ring{
  position:absolute; top:58%; left:50%; transform-style:preserve-3d;
  transform:translate(-50%,-50%) rotateX(62deg);
  border-radius:50%; box-shadow:0 0 18px rgba(4,217,255,.35) inset, 0 0 18px rgba(4,217,255,.35);
  border:2px solid rgba(4,217,255,.6); filter:drop-shadow(0 4px 10px rgba(4,217,255,.25))
}
.mint-orbits .r1{width:56vmin;height:56vmin;animation:ring-spin 48s linear infinite}
.mint-orbits .r2{width:72vmin;height:72vmin;animation:ring-spin 72s linear infinite reverse}
.mint-orbits .r3{width:88vmin;height:88vmin;animation:ring-spin 96s linear infinite}
@keyframes ring-spin{from{transform:translate(-50%,-50%) rotateX(62deg) rotateZ(0)} to{transform:translate(-50%,-50%) rotateX(62deg) rotateZ(360deg)}}

.o4-header{position:relative; z-index:6; text-align:center; margin-bottom:1.25rem}
.neon-title{
