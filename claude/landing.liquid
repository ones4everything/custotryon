  justify-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

#o4-landing-{{ section.id }} .o4-install::before {
  content: "";
  position: absolute;
  inset: -24% 16%;
  background: radial-gradient(circle, rgba(67, 231, 255, 0.2), transparent 65%);
  opacity: 0.65;
  filter: blur(18px);
}

#o4-landing-{{ section.id }} .o4-install__title {
  font-family: 'Orbitron', sans-serif;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-size: 1rem;
  margin: 0;
}

#o4-landing-{{ section.id }} .o4-install__subtitle {
  color: var(--o4-ink-soft);
  margin: 0;
  font-size: 0.95rem;
}

#o4-landing-{{ section.id }} .o4-install__btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  border-radius: 999px;
  border: 1px solid rgba(67, 231, 255, 0.45);
  background: rgba(67, 231, 255, 0.2);
  color: #eaffff;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 700;
  font-size: 0.8rem;
  text-decoration: none;
  box-shadow: 0 0 22px rgba(67, 231, 255, 0.45);
}

#o4-landing-{{ section.id }} .o4-install--hero {
  max-width: 460px;
  margin: 16px auto 0;
  padding: 18px;
}

#o4-landing-{{ section.id }} .o4-bottom-nav {
  margin-top: 36px;
  padding: 14px 20px;
  border-radius: 999px;
  border: 1px solid rgba(67, 231, 255, 0.25);
  background: rgba(6, 12, 24, 0.82);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: 0 14px 38px rgba(0, 0, 0, 0.45);
}

#o4-landing-{{ section.id }} .o4-bottom-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: rgba(230, 250, 255, 0.9);
  text-decoration: none;
  font-family: 'Orbitron', sans-serif;
  font-size: 0.78rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

#o4-landing-{{ section.id }} .o4-bottom-link svg {
