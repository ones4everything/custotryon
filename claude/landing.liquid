  height: 20px;
  color: var(--o4-cyan);
}

[data-reveal] {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.6s ease, transform 0.6s ease;
  transition-delay: var(--delay, 0s);
}

[data-reveal].is-visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes o4-ring-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

:root{
  --o4-orbit-speed: 35s;
  --neon: #3ee5ff;
  --stroke: {{ section.settings.txt_stroke | default: '#3ee5ff' }};
  --strokeW: {{ section.settings.txt_stroke_w | default: 6 }}px;
  --mint-rgb: 62,229,255;
  --ember-rgb: 255,138,76;
}

#o4-hero-wrapper-{{ section.id }}{
  font-family: 'Space Grotesk', sans-serif;
  overflow: hidden;
  min-height: 100vh;
  width: 100%;
  position: relative;
  isolation: isolate;
  touch-action: pan-y;
  background:
    radial-gradient(120% 80% at 50% 92%, rgba(var(--ember-rgb),.16), transparent 55%),
    radial-gradient(95% 70% at 16% 34%, rgba(var(--mint-rgb),.16), transparent 60%),
    radial-gradient(90% 70% at 84% 26%, rgba(166,77,255,.12), transparent 60%),
    linear-gradient(180deg,#081524 0%, #060f1c 100%);
