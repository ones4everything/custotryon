.o4-meteors{position:absolute; inset:0; z-index:7; pointer-events:none; contain:paint}
.meteor{
  position:absolute; top:0; left:0; width:3px; height:200px; transform-origin:top left;
  transform:translateZ(0) rotate(45deg); animation:streak 5.5s linear infinite;
  mix-blend-mode:screen; pointer-events:none;
  background:linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,.9) 12%, rgba(4,217,255,.8) 55%, rgba(4,217,255,0) 100%);
  box-shadow:0 0 12px rgba(255,255,255,.85), 0 0 28px rgba(4,217,255,.7)
}
.meteor::before{
  content:"";position:absolute;top:-10px;left:-10px;width:22px;height:22px;border-radius:50%;
  background:radial-gradient(circle, #ffffff 0%, rgba(255,255,255,.95) 40%, rgba(4,217,255,.55) 70%, transparent 75%);
  filter:blur(.2px);animation:flash .9s ease-out infinite
}
@keyframes streak{
  0%{transform:translateX(110vw) translateY(-60vh) rotate(45deg)}
  100%{transform:translateX(-60vw) translateY(110vh) rotate(45deg)}
}
@keyframes flash{
  0%{opacity:0;transform:scale(.8)}
  15%{opacity:1;transform:scale(1.15)}
  100%{opacity:0;transform:scale(1)}
}

@media (prefers-reduced-motion: reduce){
  .o4-motion .parallax,
  .o4-motion .streaks,
  .o4-motion .veil,
  .glow-base,
  .mint-orbits .ring{
    animation: none !important;
  }
  .o4-motion .parallax,
  .o4-motion .streaks,
  .o4-motion .veil,
  .glow-base{
    transform: none !important;
  }
}

