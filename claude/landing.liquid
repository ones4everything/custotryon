<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Orbitron:wght@600;700;800&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">

{% assign primary_link = section.settings.primary_link %}
{% if primary_link == blank %}
  {% assign primary_link = routes.all_products_collection_url %}
{% endif %}
{% assign install_link = section.settings.install_link %}
{% if install_link == blank %}
  {% assign install_link = routes.root_url %}
{% endif %}
{% assign featured_collection = section.settings.featured_collection %}

<style>
:root {
  --o4-ink: #e8f6ff;
  --o4-ink-soft: rgba(200, 224, 255, 0.7);
  --o4-bg: #05070e;
  --o4-panel: rgba(7, 12, 24, 0.72);
  --o4-line: rgba(140, 210, 255, 0.24);
  --o4-cyan: #43e7ff;
  --o4-pink: #ff5bd6;
  --o4-gold: #ffd06c;
  --o4-green: #6bffb5;
}

#o4-landing-{{ section.id }} {
  position: relative;
  color: var(--o4-ink);
  background: transparent;
  overflow: visible;
  font-family: 'Space Grotesk', sans-serif;
}

#o4-landing-{{ section.id }} .o4-landing-body {
  position: relative;
  background:
    radial-gradient(90% 70% at 15% 12%, rgba(67, 231, 255, 0.18), transparent 60%),
    radial-gradient(80% 60% at 88% 18%, rgba(255, 91, 214, 0.18), transparent 62%),
    radial-gradient(120% 90% at 50% 95%, rgba(255, 208, 108, 0.12), transparent 62%),
    linear-gradient(180deg, #05070e 0%, #05060c 45%, #04050b 100%);
  overflow: hidden;
}

#o4-landing-{{ section.id }} * {
  box-sizing: border-box;
}

#o4-landing-{{ section.id }} .o4-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 48px 16px 90px;
  position: relative;
  z-index: 2;
}

#o4-landing-{{ section.id }} .o4-aurora {
  position: absolute;
  inset: -15% -10%;
  background:
    conic-gradient(from 120deg, rgba(67, 231, 255, 0.08), rgba(255, 91, 214, 0.12), rgba(67, 231, 255, 0.08)),
    radial-gradient(60% 60% at 50% 50%, rgba(67, 231, 255, 0.08), transparent 70%);
  filter: blur(40px);
  opacity: 0.85;
  pointer-events: none;
  z-index: 0;
}

#o4-landing-{{ section.id }} .o4-grid {
  display: grid;
  gap: 28px;
}

#o4-landing-{{ section.id }} .o4-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  gap: 36px;
  align-items: center;
  padding: clamp(64px, 10vw, 120px) 0 24px;
}

#o4-landing-{{ section.id }} .o4-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

#o4-landing-{{ section.id }} .o4-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  border: 1px solid rgba(67, 231, 255, 0.4);
  background: rgba(8, 14, 26, 0.7);
  text-transform: uppercase;
  letter-spacing: 0.24em;
  font-size: 0.68rem;
  color: var(--o4-cyan);
  font-family: 'Orbitron', sans-serif;
}

#o4-landing-{{ section.id }} .o4-min-toggle {
  display: grid;
  gap: 4px;
  justify-items: start;
}

#o4-landing-{{ section.id }} .o4-min-toggle__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  background: rgba(8, 14, 24, 0.7);
  color: var(--o4-ink);
  font-family: 'Orbitron', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

#o4-landing-{{ section.id }} .o4-min-toggle__btn:hover,
#o4-landing-{{ section.id }} .o4-min-toggle__btn:focus-visible {
  transform: translateY(-1px);
  border-color: rgba(67, 231, 255, 0.45);
  box-shadow: 0 0 18px rgba(67, 231, 255, 0.35);
}

#o4-landing-{{ section.id }} .o4-min-toggle__btn[aria-pressed="true"] {
  border-color: rgba(67, 231, 255, 0.6);
  box-shadow: 0 0 18px rgba(67, 231, 255, 0.45);
}

#o4-landing-{{ section.id }} .o4-min-toggle__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.4);
  background: rgba(8, 14, 24, 0.9);
  box-shadow: inset 0 0 6px rgba(67, 231, 255, 0.3);
}

#o4-landing-{{ section.id }} .o4-min-toggle__btn[aria-pressed="true"] .o4-min-toggle__dot {
  background: var(--o4-cyan);
  border-color: var(--o4-cyan);
  box-shadow: 0 0 10px rgba(67, 231, 255, 0.6);
}

#o4-landing-{{ section.id }} .o4-min-toggle__help {
  font-size: 0.72rem;
  color: var(--o4-ink-soft);
}

#o4-landing-{{ section.id }} .o4-hero__title {
  font-family: 'Orbitron', sans-serif;
  text-transform: uppercase;
  font-weight: 800;
  font-size: clamp(2.6rem, 6vw, 4.8rem);
  letter-spacing: 0.1em;
  margin: 16px 0 10px;
  color: #ffffff;
  text-shadow: 0 0 18px rgba(67, 231, 255, 0.35), 0 0 32px rgba(255, 91, 214, 0.28);
}

#o4-landing-{{ section.id }} .o4-hero__subtitle {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--o4-ink-soft);
  max-width: 520px;
  margin: 0 0 22px;
}

#o4-landing-{{ section.id }} .o4-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 20px;
}

#o4-landing-{{ section.id }} .o4-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 14px 26px;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-size: 0.85rem;
  border: 1px solid transparent;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

#o4-landing-{{ section.id }} .o4-btn--primary {
  background: linear-gradient(90deg, rgba(67, 231, 255, 1), rgba(255, 91, 214, 1));
  color: #041018;
  box-shadow: 0 12px 30px rgba(67, 231, 255, 0.35);
}

#o4-landing-{{ section.id }} .o4-btn--ghost {
  border-color: rgba(255, 255, 255, 0.2);
  color: var(--o4-ink);
  background: rgba(9, 14, 24, 0.7);
}

#o4-landing-{{ section.id }} .o4-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(67, 231, 255, 0.35);
}

#o4-landing-{{ section.id }} .o4-hero__meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}

#o4-landing-{{ section.id }} .o4-meta-card {
  padding: 12px 14px;
  border-radius: 14px;
  background: var(--o4-panel);
  border: 1px solid var(--o4-line);
  font-size: 0.9rem;
  color: var(--o4-ink-soft);
}

#o4-landing-{{ section.id }} .o4-meta-card strong {
  display: block;
  font-family: 'Orbitron', sans-serif;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.72rem;
  color: var(--o4-cyan);
  margin-bottom: 6px;
}

#o4-landing-{{ section.id }} .o4-hero__media {
  position: relative;
  display: grid;
  place-items: center;
}

#o4-landing-{{ section.id }} .o4-orbit {
  position: relative;
  width: min(420px, 82vw);
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
}

#o4-landing-{{ section.id }} .o4-orbit__ring {
  position: absolute;
  inset: 6%;
  border-radius: 50%;
  border: 1px solid rgba(67, 231, 255, 0.35);
  box-shadow: 0 0 25px rgba(67, 231, 255, 0.35), inset 0 0 18px rgba(67, 231, 255, 0.2);
  animation: o4-ring-spin 20s linear infinite;
}

#o4-landing-{{ section.id }} .o4-orbit__ring::before {
  content: "";
  position: absolute;
  inset: 14%;
  border-radius: 50%;
  border: 1px solid rgba(255, 91, 214, 0.45);
  box-shadow: 0 0 25px rgba(255, 91, 214, 0.35), inset 0 0 18px rgba(255, 91, 214, 0.2);
  animation: o4-ring-spin 16s linear infinite reverse;
}

#o4-landing-{{ section.id }} .o4-orbit__core {
  position: relative;
  width: 64%;
  aspect-ratio: 1 / 1;
  border-radius: 22px;
  background: rgba(7, 12, 24, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 28px rgba(67, 231, 255, 0.3);
  overflow: hidden;
  display: grid;
  place-items: center;
}

#o4-landing-{{ section.id }} .o4-orbit__core img,
#o4-landing-{{ section.id }} .o4-orbit__core svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#o4-landing-{{ section.id }} .o4-strip {
  margin-top: 14px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 8px;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}

#o4-landing-{{ section.id }} .o4-strip__pill {
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(8, 14, 26, 0.68);
  border: 1px solid rgba(255, 255, 255, 0.1);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(210, 240, 255, 0.85);
  text-align: center;
}

#o4-landing-{{ section.id }} .o4-section {
  margin-top: clamp(40px, 8vw, 96px);
  display: grid;
  gap: 22px;
}

#o4-landing-{{ section.id }} .o4-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

#o4-landing-{{ section.id }} .o4-section__title {
  font-family: 'Orbitron', sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 1.1rem;
  color: var(--o4-cyan);
}

#o4-landing-{{ section.id }} .o4-section__subtitle {
  color: var(--o4-ink-soft);
  max-width: 460px;
}

#o4-landing-{{ section.id }} .o4-runway {
  --o4-runway-card-w: 320px;
  --o4-runway-card-h: 240px;
  --o4-runway-gap: 90px;
  --o4-runway-anim: 1.15s;
  --o4-runway-fade: 0.9s;
  display: block;
}

#o4-landing-{{ section.id }} .o4-runway-scene {
  position: relative;
}

#o4-landing-{{ section.id }} .o4-runway-track {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

#o4-landing-{{ section.id }} .o4-runway-card {
  position: relative;
  border-radius: 24px;
  padding: 18px;
  background: linear-gradient(160deg, rgba(10, 18, 34, 0.95), rgba(6, 10, 20, 0.92));
  border: 1px solid rgba(255, 255, 255, 0.18);
  overflow: hidden;
  text-decoration: none;
  color: var(--o4-ink);
  min-height: 240px;
  display: grid;
  align-items: end;
  justify-items: center;
  isolation: isolate;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

#o4-landing-{{ section.id }} .o4-runway-card::before {
  content: "";
  position: absolute;
  inset: 10px;
  border-radius: 18px;
  border: 1px solid rgba(67, 231, 255, 0.4);
  background:
    linear-gradient(140deg, rgba(255, 255, 255, 0.12), rgba(67, 231, 255, 0.04) 48%, rgba(255, 91, 214, 0.08) 72%, transparent 100%),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 6px);
  box-shadow:
    inset 0 0 28px rgba(67, 231, 255, 0.2),
    inset 0 0 60px rgba(5, 10, 20, 0.65);
  pointer-events: none;
  z-index: 1;
}

#o4-landing-{{ section.id }} .o4-runway-card::after {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: -18%;
  height: 40%;
  border-radius: 999px;
  background: radial-gradient(60% 60% at 50% 0%, rgba(67, 231, 255, 0.45), transparent 70%);
  filter: blur(10px);
  pointer-events: none;
  z-index: 0;
}

#o4-landing-{{ section.id }} .o4-runway-card__flash {
  position: absolute;
  inset: 16px;
  border-radius: 16px;
  pointer-events: none;
  opacity: 0;
  mix-blend-mode: screen;
  background:
    radial-gradient(28% 28% at 70% 30%, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 62%),
    radial-gradient(26% 26% at 26% 74%, rgba(67, 231, 255, 0.32), rgba(67, 231, 255, 0) 65%),
    radial-gradient(24% 24% at 80% 20%, rgba(255, 91, 214, 0.32), rgba(255, 91, 214, 0) 68%);
  filter: blur(0.6px) drop-shadow(0 0 14px rgba(67, 231, 255, 0.28));
  transition: opacity 0.2s ease;
  z-index: 2;
}

#o4-landing-{{ section.id }} .o4-runway:not(.o4-runway--carousel) .o4-runway-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 26px 60px rgba(0, 0, 0, 0.55), 0 0 32px rgba(67, 231, 255, 0.25);
}

#o4-landing-{{ section.id }} .o4-runway-card:hover .o4-runway-card__flash,
#o4-landing-{{ section.id }} .o4-runway-card:focus-visible .o4-runway-card__flash {
  opacity: 0.9;
  animation: o4-runway-flash 0.9s cubic-bezier(0.25, 0.9, 0.25, 1) 1,
    o4-runway-ambient 4.6s ease-in-out 1.1s infinite;
}

#o4-landing-{{ section.id }} .o4-runway-card img,
#o4-landing-{{ section.id }} .o4-runway-card svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  opacity: 0.6;
  filter: saturate(1.15) contrast(1.05);
  transform: scale(1.05);
  transition: transform 0.35s ease, opacity 0.35s ease;
  z-index: 0;
}

#o4-landing-{{ section.id }} .o4-runway-card:hover img,
#o4-landing-{{ section.id }} .o4-runway-card:hover svg {
  transform: scale(1.12);
  opacity: 0.75;
}

#o4-landing-{{ section.id }} .o4-runway-card__label {
  position: relative;
  z-index: 2;
  font-family: 'Orbitron', sans-serif;
  font-size: 0.98rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 10px 18px;
  border-radius: 999px;
  border: 1px solid rgba(67, 231, 255, 0.45);
  background: rgba(6, 10, 20, 0.82);
  box-shadow: 0 0 18px rgba(67, 231, 255, 0.25);
  text-shadow: 0 0 12px rgba(67, 231, 255, 0.35);
}

#o4-landing-{{ section.id }} .o4-runway-nav {
  display: none;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 16px;
}

#o4-landing-{{ section.id }} .o4-runway-btn {
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: 1px solid rgba(67, 231, 255, 0.3);
  background: rgba(6, 10, 20, 0.72);
  color: var(--o4-ink);
  font-size: 1.4rem;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

#o4-landing-{{ section.id }} .o4-runway-btn:hover,
#o4-landing-{{ section.id }} .o4-runway-btn:focus-visible {
  transform: translateY(-1px);
  border-color: rgba(67, 231, 255, 0.5);
  box-shadow: 0 0 18px rgba(67, 231, 255, 0.3);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .o4-runway-nav {
  display: flex;
}

#o4-landing-{{ section.id }} .o4-runway--carousel .o4-runway-scene {
  width: min(760px, 100%);
  height: var(--o4-runway-card-h);
  margin: 0 auto;
  perspective: 2000px;
}

#o4-landing-{{ section.id }} .o4-runway--carousel .o4-runway-track {
  position: relative;
  height: 100%;
  display: block;
  transform-style: preserve-3d;
}

#o4-landing-{{ section.id }} .o4-runway--carousel .o4-runway-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  width: var(--o4-runway-card-w);
  height: var(--o4-runway-card-h);
  min-height: 0;
  transform: translate(-50%, -50%);
  opacity: 0;
  pointer-events: none;
  transition: transform var(--o4-runway-anim) cubic-bezier(0.65, 0, 0.35, 1),
    opacity var(--o4-runway-fade) ease,
    filter var(--o4-runway-fade) ease;
  filter: drop-shadow(0 0 0 rgba(67, 231, 255, 0));
  will-change: transform, opacity;
}

#o4-landing-{{ section.id }} .o4-runway--carousel .o4-runway-panel.is-active {
  opacity: 1;
  pointer-events: auto;
  z-index: 10;
  filter: drop-shadow(0 0 22px rgba(67, 231, 255, 0.32));
}

#o4-landing-{{ section.id }} .o4-runway--carousel .panel-left {
  transform: translate(-50%, -50%) translateX(20%) scale(0.72) rotateY(90deg);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .panel-left.is-active {
  transform: translate(-50%, -50%) translateX(calc(-50% - (var(--o4-runway-gap) / 2))) scale(1) rotateY(0);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .panel-left.is-exiting {
  transform: translate(-50%, -50%) translateX(20%) scale(0.7) rotateY(360deg) rotateX(12deg);
  opacity: 0;
  z-index: 5;
  filter: brightness(1.1) blur(0.5px);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .panel-right {
  transform: translate(-50%, -50%) translateX(-20%) scale(0.72) rotateY(-90deg);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .panel-right.is-active {
  transform: translate(-50%, -50%) translateX(calc(50% + (var(--o4-runway-gap) / 2))) scale(1) rotateY(0);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .panel-right.is-exiting {
  transform: translate(-50%, -50%) translateX(-20%) scale(0.7) rotateY(-360deg) rotateX(12deg);
  opacity: 0;
  z-index: 5;
  filter: brightness(1.1) blur(0.5px);
}

#o4-landing-{{ section.id }} .o4-runway--carousel .o4-runway-card:hover {
  box-shadow: 0 26px 60px rgba(0, 0, 0, 0.55), 0 0 32px rgba(67, 231, 255, 0.25);
}

#o4-landing-{{ section.id }} .o4-runway--carousel [data-reveal],
#o4-landing-{{ section.id }} .o4-runway--carousel [data-reveal].is-visible {
  opacity: 1;
  transform: none;
  transition: none;
}

@media (max-width: 900px) {
  #o4-landing-{{ section.id }} .o4-runway {
    --o4-runway-card-w: 260px;
    --o4-runway-card-h: 220px;
    --o4-runway-gap: 50px;
  }
}

@media (max-width: 640px) {
  #o4-landing-{{ section.id }} .o4-runway {
    --o4-runway-card-w: 220px;
    --o4-runway-card-h: 200px;
    --o4-runway-gap: 28px;
  }
}

@keyframes o4-runway-flash {
  0% {
    opacity: 0;
    transform: scale(0.98);
    filter: blur(1.6px) drop-shadow(0 0 12px rgba(255, 255, 255, 0.2));
  }
  35% {
    opacity: 1;
    transform: scale(1.01);
    filter: blur(0.6px) drop-shadow(0 0 20px rgba(67, 231, 255, 0.45));
  }
  100% {
    opacity: 0.25;
    transform: scale(1);
    filter: blur(0.4px) drop-shadow(0 0 10px rgba(67, 231, 255, 0.25));
  }
}

@keyframes o4-runway-ambient {
  0%, 100% { opacity: 0.22; }
  50% { opacity: 0.45; }
}

#o4-landing-{{ section.id }} .o4-collection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 18px;
}

#o4-landing-{{ section.id }} .o4-collection-card {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  background: rgba(8, 12, 24, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
  display: grid;
  gap: 12px;
}

#o4-landing-{{ section.id }} .o4-collection-card img,
#o4-landing-{{ section.id }} .o4-collection-card svg {
  width: 100%;
  height: 220px;
  object-fit: cover;
}

#o4-landing-{{ section.id }} .o4-collection-card__body {
  padding: 14px 16px 18px;
}

#o4-landing-{{ section.id }} .o4-collection-card__title {
  font-weight: 600;
  margin: 0 0 6px;
  font-size: 1rem;
}

#o4-landing-{{ section.id }} .o4-collection-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--o4-ink-soft);
  font-size: 0.85rem;
}

#o4-landing-{{ section.id }} .o4-collection-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
  color: var(--o4-cyan);
  text-decoration: none;
}

#o4-landing-{{ section.id }} .o4-install {
  display: grid;
  gap: 12px;
  padding: 20px;
  border-radius: 20px;
  background: rgba(6, 10, 20, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.14);
