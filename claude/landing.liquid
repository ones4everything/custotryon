<script>
(() => {
  const root = document.getElementById('o4-landing-{{ section.id }}');
  if (!root) return;
  const items = Array.from(root.querySelectorAll('[data-reveal]'));
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) {
    items.forEach(item => item.classList.add('is-visible'));
    return;
  }
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  items.forEach(item => observer.observe(item));
})();
</script>

<script>
(() => {
  const MINIMAL_KEY = 'o4MinimalMode';
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const toggles = Array.from(document.querySelectorAll('[data-minimal-toggle]'));

  const applyMinimal = (enabled, persist) => {
    document.body.classList.toggle('mode-minimal', enabled);
    toggles.forEach((btn) => {
      btn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
    });
    if (persist) {
      localStorage.setItem(MINIMAL_KEY, String(enabled));
    }
  };

  const stored = localStorage.getItem(MINIMAL_KEY);
  const initial = stored === null ? prefersReduced.matches : stored === 'true';
  applyMinimal(initial, false);

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      applyMinimal(!document.body.classList.contains('mode-minimal'), true);
    });
  });

  if (stored === null) {
    prefersReduced.addEventListener('change', (event) => {
      applyMinimal(event.matches, false);
    });
  }
})();
</script>

<script>
(() => {
  const root = document.getElementById('o4-landing-{{ section.id }}');
  if (!root) return;
  const runway = root.querySelector('[data-runway-carousel]');
  if (!runway) return;
  const track = runway.querySelector('[data-runway-track]');
  if (!track) return;
  const panels = Array.from(track.querySelectorAll('.o4-runway-panel'));
  if (!panels.length) return;

  const nav = runway.querySelector('.o4-runway-nav');
  const prevBtn = runway.querySelector('[data-runway-prev]');
  const nextBtn = runway.querySelector('[data-runway-next]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let pairIndices = [];
  let currentPair = 0;
  let isAnimating = false;
  let autoTimer = null;

  const durationMs = () => {
    const raw = getComputedStyle(runway).getPropertyValue('--o4-runway-anim').trim();
    if (!raw) return 1150;
    if (raw.endsWith('ms')) return parseFloat(raw) || 1150;
    if (raw.endsWith('s')) return (parseFloat(raw) || 1.15) * 1000;
    const num = parseFloat(raw);
    return Number.isFinite(num) ? (num <= 10 ? num * 1000 : num) : 1150;
  };

  const setNav = (visible) => {
    if (nav) {
      if (visible) nav.removeAttribute('hidden');
      else nav.setAttribute('hidden', '');
    }
    if (prevBtn) prevBtn.disabled = !visible;
    if (nextBtn) nextBtn.disabled = !visible;
  };

  const resetPanels = () => {
    panels.forEach((panel) => {
      panel.classList.remove('panel-left', 'panel-right', 'is-active', 'is-exiting');
    });
  };

  const assignSides = () => {
    panels.forEach((panel, index) => {
      if (index % 2 === 0) {
        panel.classList.add('panel-left');
        panel.classList.remove('panel-right');
      } else {
        panel.classList.add('panel-right');
        panel.classList.remove('panel-left');
      }
    });
  };

  const buildPairs = () => {
    pairIndices = [];
    for (let i = 0; i < panels.length; i += 2) {
      pairIndices.push(i);
    }
  };

  const setActivePair = () => {
    const start = pairIndices[currentPair];
    if (start === undefined) return;
    const panelOne = panels[start];
    const panelTwo = panels[start + 1];
    if (panelOne) panelOne.classList.add('is-active');
    if (panelTwo) panelTwo.classList.add('is-active');
  };

  const clearActivePair = (start) => {
    const panelOne = panels[start];
    const panelTwo = panels[start + 1];
    if (panelOne) {
      panelOne.classList.remove('is-active');
      panelOne.classList.add('is-exiting');
    }
    if (panelTwo) {
      panelTwo.classList.remove('is-active');
      panelTwo.classList.add('is-exiting');
    }
    window.setTimeout(() => {
      if (panelOne) panelOne.classList.remove('is-exiting');
      if (panelTwo) panelTwo.classList.remove('is-exiting');
      isAnimating = false;
    }, durationMs() + 80);
  };

  const showNext = () => {
    if (isAnimating || pairIndices.length <= 1) return;
    isAnimating = true;
    clearActivePair(pairIndices[currentPair]);
    currentPair = (currentPair + 1) % pairIndices.length;
    setActivePair();
  };

  const showPrev = () => {
    if (isAnimating || pairIndices.length <= 1) return;
    isAnimating = true;
    clearActivePair(pairIndices[currentPair]);
    currentPair = (currentPair - 1 + pairIndices.length) % pairIndices.length;
    setActivePair();
  };

  const stopAutoplay = () => {
    if (!autoTimer) return;
    window.clearInterval(autoTimer);
    autoTimer = null;
  };

  const allowAutoplay = () =>
    !document.body.classList.contains('mode-minimal') && !prefersReduced.matches;
  const startAutoplay = () => {
    if (autoTimer || pairIndices.length <= 1 || !allowAutoplay()) return;
    autoTimer = window.setInterval(showNext, 5200);
  };

  const enableCarousel = () => {
    runway.classList.add('o4-runway--carousel');
    resetPanels();
    assignSides();
    buildPairs();
    currentPair = 0;
    setActivePair();
    const hasNav = pairIndices.length > 1;
    setNav(hasNav);
    stopAutoplay();
    if (hasNav) startAutoplay();
  };

  const disableCarousel = () => {
    stopAutoplay();
    setNav(false);
    resetPanels();
    runway.classList.remove('o4-runway--carousel');
  };

  const canAnimate = () => true;
  const syncMode = () => {
    if (canAnimate()) enableCarousel();
    else disableCarousel();
  };

  if (prevBtn) prevBtn.addEventListener('click', showPrev);
  if (nextBtn) nextBtn.addEventListener('click', showNext);
  runway.addEventListener('mouseenter', stopAutoplay);
  runway.addEventListener('mouseleave', startAutoplay);
  runway.addEventListener('focusin', stopAutoplay);
  runway.addEventListener('focusout', startAutoplay);

  track.setAttribute('tabindex', '0');
  track.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPrev();
    if (event.key === 'ArrowRight') showNext();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      stopAutoplay();
    } else if (canAnimate() && allowAutoplay()) {
      startAutoplay();
    }
  });

  if (prefersReduced.addEventListener) {
    prefersReduced.addEventListener('change', syncMode);
  } else if (prefersReduced.addListener) {
    prefersReduced.addListener(syncMode);
  }

  new MutationObserver(syncMode).observe(document.body, {
    attributes: true,
    attributeFilter: ['class']
  });

  syncMode();
})();
</script>

