/* --- PRODUCT GRID + GLOW CARDS --- */
@keyframes rotate-glow {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 5px var(--primary-glow), 0 0 10px var(--primary-glow); }
  50% { box-shadow: 0 0 10px var(--secondary-glow), 0 0 15px var(--secondary-glow); }
}

#o4-premium-{{ section.id }} .o4-content-area {
  flex: 1;
  width: 100%;
}

#o4-premium-{{ section.id }} .o4-heading {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 5vw, 3.5rem);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin: 0;
  text-align: left;
}

#o4-premium-{{ section.id }} .o4-grid,
#o4-premium-{{ section.id }} .product-grid {
  display: grid;
  gap: 2rem;
  padding: 0;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

#o4-premium-{{ section.id }} [data-theme="purple"] {
  --primary-glow: #ff00a8;
  --secondary-glow: #ffe6f7;
}

#o4-premium-{{ section.id }} [data-theme="orange"] {
  --primary-glow: #ffc300;
  --secondary-glow: #fff8e1;
}

#o4-premium-{{ section.id }} [data-theme="cyan"] {
  --primary-glow: #00ffff;
  --secondary-glow: #e0f7ff;
}

#o4-premium-{{ section.id }} .product-card {
  --primary-glow: #00ffff;
  --secondary-glow: #e0f7ff;
  position: relative;
  background: transparent;
  overflow: hidden;
  transition: transform 0.3s ease;
  z-index: 1;
  padding: 3px;
  clip-path: polygon(0 15px, 15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%);
}

#o4-premium-{{ section.id }} .product-card:hover {
  transform: translateY(-10px);
}

#o4-premium-{{ section.id }} .product-card::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  padding-bottom: 200%;
  background: conic-gradient(from 0deg, transparent 50%, var(--primary-glow), var(--secondary-glow), var(--primary-glow), transparent 70%);
  z-index: -1;
  animation: rotate-glow 6s linear infinite;
  opacity: 0.8;
}

#o4-premium-{{ section.id }} .product-card-content {
  background: rgba(12, 10, 9, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  clip-path: polygon(0 15px, 15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%);
  position: relative;
  z-index: 2;
  padding: 1.25rem;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

#o4-premium-{{ section.id }} .product-image-container {
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}

#o4-premium-{{ section.id }} .product-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 0 15px var(--primary-glow));
  transition: transform 0.3s ease;
}

#o4-premium-{{ section.id }} .product-card:hover .product-image {
  transform: scale(1.05);
}

#o4-premium-{{ section.id }} .product-details {
  text-align: center;
}

#o4-premium-{{ section.id }} .product-name {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 800;
  margin-bottom: 0.35rem;
  color: #e6eef7;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.65), 0 0 1px rgba(255, 255, 255, 0.15);
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

#o4-premium-{{ section.id }} .product-name a {
  color: inherit;
  text-decoration: none;
}

#o4-premium-{{ section.id }} .product-price {
  font-size: 1.1rem;
  font-weight: 900;
  margin-bottom: 1rem;
  color: var(--primary-glow);
  text-shadow: 0 0 8px var(--primary-glow), 0 1px 2px rgba(0, 0, 0, 0.5);
}

#o4-premium-{{ section.id }} .add-to-cart-btn {
  font-family: var(--font-body);
  font-weight: 700;
  letter-spacing: 0.06em;
  background: transparent;
  border: 2px solid var(--primary-glow);
  border-radius: 8px;
  color: var(--primary-glow);
  padding: 0.6rem 1.2rem;
  font-size: 0.75rem;
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, transform 0.1s ease;
  text-transform: uppercase;
  animation: pulse 3s infinite ease-in-out;
  width: 100%;
}

#o4-premium-{{ section.id }} .add-to-cart-btn:hover {
  background-color: var(--primary-glow);
  color: #0c0a09;
  animation-play-state: paused;
  box-shadow: 0 0 10px var(--primary-glow), 0 0 20px var(--primary-glow);
}

#o4-premium-{{ section.id }} .add-to-cart-btn:active {
  transform: scale(0.95);
}

#o4-premium-{{ section.id }} .add-to-cart-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  animation: none;
}

@media (max-width: 768px) {
  #o4-premium-{{ section.id }} .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  #o4-premium-{{ section.id }} .product-name {
