                          <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                          <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                          <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        </svg>
                      </span>
                      <span class="cdm__label">View All Hoodies</span>
                      <span class="cdm__row-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                          <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </a>
                  </li>
                </ul>
              </section>
            {% endif %}
          </div>
        </div>
      </aside>
    </div>

    <div class="o4-main-layout">
      <div class="o4-content-area">
        <div class="o4-heading-row">
          <button class="cdm__trigger" type="button" data-cdm-open aria-controls="cdm-drawer-{{ section.id }}" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
              <path d="M4 6h16" stroke-linecap="round"></path>
              <path d="M4 12h16" stroke-linecap="round"></path>
              <path d="M4 18h16" stroke-linecap="round"></path>
            </svg>
            <span>Menu</span>
          </button>
          <h1 class="o4-heading">{{ heading_title | default: "Shop" }}</h1>
          <div class="o4-min-toggle">
            <button class="o4-min-toggle__btn" type="button" data-minimal-toggle aria-pressed="false" aria-describedby="o4-min-help-{{ section.id }}">
              <span class="o4-min-toggle__dot" aria-hidden="true"></span>
              <span class="o4-min-toggle__label">Minimal Mode</span>
            </button>
            <span class="o4-min-toggle__help" id="o4-min-help-{{ section.id }}">Simplified layout for focus</span>
          </div>
        </div>

        {% if active_collection %}
          <div class="o4-grid product-grid">
            {% for product in active_collection.products limit: section.settings.limit %}
              {% assign theme_cycle = forloop.index | modulo: 3 %}
              {% if theme_cycle == 1 %}
                {% assign data_theme = 'purple' %}
              {% elsif theme_cycle == 2 %}
                {% assign data_theme = 'cyan' %}
              {% else %}
                {% assign data_theme = 'orange' %}
              {% endif %}

              <div class="product-card" data-theme="{{ data_theme }}">
                <div class="product-card-content">
                  <a href="{{ product.url | within: active_collection }}" class="product-image-container">
                    {% if product.featured_image != blank %}
                      <img src="{{ product.featured_image | image_url: width: 400 }}"
                           alt="{{ product.featured_image.alt | escape }}"
                           loading="lazy"
                           width="400"
                           height="400"
                           class="product-image">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
                    {% endif %}
                  </a>
                  <div class="product-details">
                    <h3 class="product-name">
                      <a href="{{ product.url | within: active_collection }}">{{ product.title }}</a>
                    </h3>
                    <p class="product-price">{{ product.price | money }}</p>
                    {% form 'product', product %}
                      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                      <button type="submit" class="add-to-cart-btn" {% unless product.available %}disabled{% endunless %}>
                        {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
                      </button>
                    {% endform %}
                  </div>
                </div>
              </div>
            {% else %}
              <div class="o4-empty">No products found in this collection.</div>
            {% endfor %}
          </div>
        {% else %}
          <div class="o4-empty">Select a collection to show products.</div>
        {% endif %}
      </div>
    </div>

    {% if template.name != 'product' %}
      <div class="o4-bottom-nav" aria-label="Quick navigation">
        <nav class="o4-bottom-nav-inner">
          <a class="o4-bottom-link" href="{{ routes.root_url }}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <path d="M9 22V12h6v10"></path>
            </svg>
            <span>Home</span>
          </a>
          <a class="o4-bottom-center" href="{{ routes.all_products_collection_url }}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 2h12l-1 6H7L6 2z"></path>
              <path d="M4 8h16l-1 12H5L4 8z"></path>
            </svg>
            <span>ONES4</span>
          </a>
          <a class="o4-bottom-link" href="{{ routes.cart_url }}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="9" cy="20" r="1"></circle>
              <circle cx="17" cy="20" r="1"></circle>
              <path d="M5 5h2l2 10h9l2-7H8"></path>
            </svg>
            <span>Cart</span>
          </a>
        </nav>
      </div>
    {% endif %}
  </div>
</section>

<script>
(() => {
  const root = document.getElementById('o4-premium-{{ section.id }}');
  if (!root) return;
  document.body.classList.add('o4-hide-theme-header');
  const MINIMAL_KEY = 'o4MinimalMode';
  const minimalToggles = Array.from(root.querySelectorAll('[data-minimal-toggle]'));
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const applyMinimal = (enabled, persist) => {
    document.body.classList.toggle('mode-minimal', enabled);
    minimalToggles.forEach((btn) => {
      btn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
    });
    if (persist) {
      localStorage.setItem(MINIMAL_KEY, String(enabled));
    }
  };
  const storedMinimal = localStorage.getItem(MINIMAL_KEY);
  const initialMinimal = storedMinimal === null ? prefersReduced.matches : storedMinimal === 'true';
  applyMinimal(initialMinimal, false);
  minimalToggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      applyMinimal(!document.body.classList.contains('mode-minimal'), true);
    });
  });
  if (storedMinimal === null) {
    prefersReduced.addEventListener('change', (event) => {
      applyMinimal(event.matches, false);
    });
  }

  const drawer = root.querySelector('[data-cdm-drawer]');
  const scrim = root.querySelector('[data-cdm-scrim]');
  const openButtons = Array.from(root.querySelectorAll('[data-cdm-open]'));
  const closeButtons = Array.from(root.querySelectorAll('[data-cdm-close]'));
  const nextButtons = Array.from(root.querySelectorAll('[data-cdm-next]'));
  const backButtons = Array.from(root.querySelectorAll('[data-cdm-back]'));
  const panels = Array.from(root.querySelectorAll('[data-cdm-panel]'));
  const desktopMq = window.matchMedia('(min-width: 960px)');
  const voiceForm = root.querySelector('[data-voice-form]');
  const voiceInput = root.querySelector('[data-voice-input]');
  const voiceButton = root.querySelector('[data-voice-btn]');
  const voiceStatus = root.querySelector('[data-voice-status]');
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  let voiceActive = false;
  let recognition = null;
  let touchStartX = 0;
  let touchStartTime = 0;
  let isSwiping = false;
  const minSwipeDistance = 80;
  const minFastSwipeDistance = 30;
  const maxSwipeDuration = 250;

  const setVoiceState = (active, message) => {
    voiceActive = active;
    if (voiceButton) {
      voiceButton.classList.toggle('is-listening', active);
      voiceButton.setAttribute('aria-pressed', active ? 'true' : 'false');
    }
    if (voiceStatus) {
      voiceStatus.textContent = message || '';
    }
  };

  const initVoiceSearch = () => {
    if (!voiceButton || !voiceInput || !voiceForm) return;
    if (!SpeechRecognition) {
      voiceButton.disabled = true;
      voiceButton.setAttribute('aria-disabled', 'true');
      voiceButton.title = 'Voice search not supported';
      return;
    }

    recognition = new SpeechRecognition();
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;
    recognition.lang = document.documentElement.lang || 'en-US';

    recognition.onstart = () => setVoiceState(true, 'Listening');
    recognition.onend = () => setVoiceState(false, '');
    recognition.onerror = (event) => {
      const msg = event && event.error ? `Voice search error: ${event.error}` : 'Voice search error';
      setVoiceState(false, msg);
    };
    recognition.onresult = (event) => {
      const result = event && event.results && event.results[0] && event.results[0][0];
      const transcript = result && result.transcript ? result.transcript.trim() : '';
      if (transcript) {
        voiceInput.value = transcript;
        if (typeof voiceForm.requestSubmit === 'function') {
          voiceForm.requestSubmit();
        } else {
          voiceForm.submit();
        }
      }
    };

    voiceButton.addEventListener('click', () => {
      if (!recognition) return;
      if (voiceActive) {
        recognition.stop();
        return;
      }
      try {
        recognition.start();
      } catch (error) {
        setVoiceState(false, 'Voice search unavailable');
      }
    });
  };

  const getInitialPanel = () => {
    const activeButton = nextButtons.find((btn) => btn.classList.contains('is-active')) || nextButtons[0];
    return activeButton ? activeButton.dataset.cdmTarget : 'root';
  };

  const setPanel = (key) => {
    const targetKey = key || 'root';
    panels.forEach((panel) => {
      const panelKey = panel.dataset.cdmPanel;
      const isRoot = panelKey === 'root';
      const isActive = isRoot ? (desktopMq.matches ? true : targetKey === 'root') : panelKey === targetKey;
      panel.classList.toggle('is-active', isActive);
      panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
    });
    nextButtons.forEach((btn) => {
      if (!btn.hasAttribute('aria-expanded')) return;
      const isTarget = btn.dataset.cdmTarget === targetKey;
      btn.setAttribute('aria-expanded', isTarget ? 'true' : 'false');
      if (targetKey !== 'root') {
        btn.classList.toggle('is-active', isTarget);
      }
    });
  };

  const setDrawerOpen = (open) => {
    root.classList.toggle('cdm-open', open);
    if (drawer) drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (scrim) {
      if (open) {
        scrim.removeAttribute('hidden');
      } else {
        scrim.setAttribute('hidden', '');
      }
    }
    openButtons.forEach((btn) => btn.setAttribute('aria-expanded', open ? 'true' : 'false'));
    document.body.classList.toggle('cdm-open', open);
    if (!open) {
      setPanel(desktopMq.matches ? getInitialPanel() : 'root');
      if (drawer) {
        drawer.style.transition = '';
        drawer.style.transform = '';
      }
    }
  };

  setPanel(desktopMq.matches ? getInitialPanel() : 'root');
  initVoiceSearch();

  openButtons.forEach((btn) => {
    btn.addEventListener('click', () => setDrawerOpen(true));
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener('click', () => setDrawerOpen(false));
  });

  if (scrim) {
    scrim.addEventListener('click', () => setDrawerOpen(false));
  }

  nextButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.cdmTarget;
      if (target) setPanel(target);
    });
  });

  backButtons.forEach((btn) => {
    btn.addEventListener('click', () => setPanel('root'));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!root.classList.contains('cdm-open')) return;
    setDrawerOpen(false);
  });

  desktopMq.addEventListener('change', () => {
    setPanel(desktopMq.matches ? getInitialPanel() : 'root');
  });

  if (drawer) {
    drawer.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0].screenX;
      touchStartTime = Date.now();
      isSwiping = true;
    }, { passive: true });

    drawer.addEventListener('touchmove', (event) => {
      if (!isSwiping) return;
      const currentX = event.changedTouches[0].screenX;
      const diff = currentX - touchStartX;
      if (diff > 0) {
        drawer.style.transition = 'none';
        drawer.style.transform = `translateX(${diff}px)`;
      }
    }, { passive: false });

    drawer.addEventListener('touchend', (event) => {
      if (!isSwiping) return;
      const touchEndX = event.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      const duration = Date.now() - touchStartTime;
      const shouldClose = diff > minSwipeDistance || (diff > minFastSwipeDistance && duration < maxSwipeDuration);

      drawer.style.transition = 'transform 0.3s ease';

      if (shouldClose) {
        setDrawerOpen(false);
      } else {
        drawer.style.transform = 'translateX(0)';
      }

      isSwiping = false;
    }, { passive: true });
  }
})();
</script>

{% schema %}
{
  "name": "O4 Premium True Neon",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Heading", "default": "Shop" },
    { "type": "text", "id": "menu_title", "label": "Menu Title", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "Sidebar Menu" },
    { "type": "collection", "id": "collection", "label": "Product Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products per page", "default": 6 }
  ],
  "presets": [{ "name": "O4 Premium True Neon" }]
}
{% endschema %}
