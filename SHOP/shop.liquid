<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@300..800&family=Outfit:wght@400..900&display=swap" rel="stylesheet">

<style>
#o4-premium-{{ section.id }} {
  --font-heading: "Outfit", sans-serif;
  --font-body: "Manrope", sans-serif;
  --bg-dark: #070a14;
  --glass-bg: rgba(255, 255, 255, 0.06);
  --glass-bg-2: rgba(255, 255, 255, 0.04);
  --glass-border: rgba(255, 255, 255, 0.14);
  --glass-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
  --accent: #00b4ff;
  --text: rgba(223, 246, 255, 1);
  --muted: rgba(159, 182, 195, 1);
  --menu-bg: rgba(8, 12, 28, 0.64);
  --menu-line: rgba(255, 255, 255, 0.1);
  --menu-glass: rgba(255, 255, 255, 0.06);
  --menu-glass-soft: rgba(255, 255, 255, 0.035);
  --menu-text: rgba(255, 255, 255, 0.92);
  --menu-muted: rgba(255, 255, 255, 0.6);
  --menu-teal: #2fe4d4;
  --menu-violet: #6a3cf0;
  --cyan-glow: var(--menu-teal);
  --purple-glow: var(--menu-violet);
  position: relative;
  background-color: var(--bg-dark);
  font-family: var(--font-body);
  padding: 60px 0 140px;
  overflow: visible;
  color: #fff;
}

.o4-hide-theme-header #shopify-section-header,
.o4-hide-theme-header #shopify-section-announcement-bar,
.o4-hide-theme-header .shopify-section--header,
.o4-hide-theme-header .site-header,
.o4-hide-theme-header .header-wrapper,
.o4-hide-theme-header .announcement-bar,
.o4-hide-theme-header [data-section-type="header"],
.o4-hide-theme-header [id^="FuturisticHeader-"] {
  display: none !important;
}

#o4-premium-{{ section.id }} * {
  box-sizing: border-box;
}

#o4-premium-{{ section.id }} .o4-bg-radial {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(900px 520px at 20% 45%, rgba(47, 228, 212, 0.3), transparent 55%),
    radial-gradient(900px 520px at 78% 48%, rgba(106, 60, 240, 0.35), transparent 58%),
    linear-gradient(180deg, #070a14, #0b1020);
  z-index: 0;
}

#o4-premium-{{ section.id }} .o4-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
  position: relative;
  z-index: 5;
}

/* --- RESPONSIVE FLEX LAYOUT --- */
#o4-premium-{{ section.id }} .o4-main-layout {
  display: block;
}

/* --- CASCADE DRAWER MENU --- */
#o4-premium-{{ section.id }} .cdm {
  position: relative;
  z-index: 30;
}

body.cdm-open {
  overflow: hidden;
}

#o4-premium-{{ section.id }} .cdm__scrim {
  position: fixed;
  inset: 0;
  background: rgba(5, 8, 16, 0.78);
  backdrop-filter: blur(3px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  z-index: 30;
}

#o4-premium-{{ section.id }}.cdm-open .cdm__scrim {
  opacity: 1;
  pointer-events: auto;
}

#o4-premium-{{ section.id }} .cdm__drawer {
  position: fixed;
  top: 18px;
  left: 18px;
  bottom: 18px;
  width: min(640px, 55vw);
  border-radius: 22px;
  padding: 1px;
  background: linear-gradient(90deg, rgba(47, 228, 212, 0.08), rgba(106, 60, 240, 0.1));
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
  transform: translateX(-120%);
  opacity: 0;
  transition: transform 0.3s ease, opacity 0.3s ease;
  z-index: 40;
  touch-action: pan-y;
}

#o4-premium-{{ section.id }} .cdm__drawer::before {
  content: "";
  position: absolute;
  inset: -2px;
  border-radius: 24px;
  background: linear-gradient(90deg, rgba(47, 228, 212, 0.55), rgba(106, 60, 240, 0.55));
  opacity: 0.2;
  filter: blur(14px);
  z-index: 0;
}

#o4-premium-{{ section.id }}.cdm-open .cdm__drawer {
  transform: translateX(0);
  opacity: 1;
}

#o4-premium-{{ section.id }} .cdm__frame {
  position: relative;
  z-index: 1;
  border-radius: 22px;
  background: var(--menu-bg);
  border: 1px solid var(--menu-line);
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  backdrop-filter: blur(14px);
}

#o4-premium-{{ section.id }} .cdm__header {
  padding: 18px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: linear-gradient(90deg, rgba(47, 228, 212, 0.07), rgba(106, 60, 240, 0.06));
}

#o4-premium-{{ section.id }} .cdm__title {
  font-family: var(--font-heading);
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-size: 1.4rem;
  color: rgba(210, 245, 255, 0.92);
  text-shadow: 0 0 18px rgba(47, 228, 212, 0.25);
}

#o4-premium-{{ section.id }} .cdm__actions {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

#o4-premium-{{ section.id }} .cdm__icon-btn {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass);
  color: var(--menu-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

#o4-premium-{{ section.id }} .cdm__icon-btn svg {
  width: 18px;
  height: 18px;
  stroke-width: 2;
}

#o4-premium-{{ section.id }} .cdm__icon-btn:hover,
#o4-premium-{{ section.id }} .cdm__icon-btn:focus-visible {
  transform: translateY(-1px);
  border-color: rgba(47, 228, 212, 0.4);
  box-shadow: 0 0 16px rgba(47, 228, 212, 0.3);
}

#o4-premium-{{ section.id }} .cdm__close {
  width: 34px;
  height: 34px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass);
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--menu-text);
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

#o4-premium-{{ section.id }} .cdm__close:hover,
#o4-premium-{{ section.id }} .cdm__close:focus-visible {
  transform: translateY(-1px);
  border-color: rgba(47, 228, 212, 0.4);
  box-shadow: 0 0 16px rgba(47, 228, 212, 0.3);
}

#o4-premium-{{ section.id }} .cdm__close svg {
  width: 16px;
  height: 16px;
  stroke-width: 2;
}

#o4-premium-{{ section.id }} .cdm__search {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 12px 16px 10px;
  padding: 10px 14px;
  border-radius: 14px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass);
  backdrop-filter: blur(8px);
  position: relative;
}

#o4-premium-{{ section.id }} .cdm__search-icon {
  display: inline-flex;
  color: rgba(195, 226, 255, 0.6);
}

#o4-premium-{{ section.id }} .cdm__search-icon svg {
  width: 18px;
  height: 18px;
  stroke-width: 2;
}

#o4-premium-{{ section.id }} .cdm__search-input {
  flex: 1;
  border: 0;
  background: transparent;
  color: var(--menu-text);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 1rem;
  outline: none;
}

#o4-premium-{{ section.id }} .cdm__search-input::placeholder {
  color: rgba(195, 226, 255, 0.5);
}

#o4-premium-{{ section.id }} .cdm__voice-btn {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass);
  color: var(--menu-text);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

#o4-premium-{{ section.id }} .cdm__voice-btn svg {
  width: 18px;
  height: 18px;
  stroke-width: 2;
}

#o4-premium-{{ section.id }} .cdm__voice-btn:hover,
#o4-premium-{{ section.id }} .cdm__voice-btn:focus-visible {
  transform: translateY(-1px);
  border-color: rgba(47, 228, 212, 0.4);
  box-shadow: 0 0 16px rgba(47, 228, 212, 0.3);
}

#o4-premium-{{ section.id }} .cdm__voice-btn.is-listening {
  border-color: rgba(47, 228, 212, 0.6);
  box-shadow: 0 0 18px rgba(47, 228, 212, 0.45);
  color: #ffffff;
}

#o4-premium-{{ section.id }} .cdm__voice-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

#o4-premium-{{ section.id }} .cdm__voice-status {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

#o4-premium-{{ section.id }} .cdm__crumbs {
  margin: 0 16px 12px;
  border-radius: 12px;
  border: 1px solid rgba(47, 228, 212, 0.22);
  background: rgba(8, 12, 28, 0.65);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(12px);
}

#o4-premium-{{ section.id }} .cdm__crumbs-inner {
  height: 38px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  font-size: 0.95rem;
  font-weight: 600;
  color: rgba(214, 243, 255, 0.85);
  white-space: nowrap;
  overflow-x: auto;
}

#o4-premium-{{ section.id }} .cdm__crumbs-inner::-webkit-scrollbar {
  display: none;
}

#o4-premium-{{ section.id }} .cdm__crumbs-link {
  color: #f5fbff;
  font-weight: 700;
  text-decoration: none;
}

#o4-premium-{{ section.id }} .cdm__crumbs-link:hover {
  text-decoration: underline;
}

#o4-premium-{{ section.id }} .cdm__crumbs-sep {
  opacity: 0.6;
  color: rgba(214, 243, 255, 0.55);
}

#o4-premium-{{ section.id }} .cdm__panels {
  position: relative;
  flex: 1;
  padding: 6px 16px 16px;
  overflow: hidden;
}

#o4-premium-{{ section.id }} .cdm__panel {
  position: absolute;
  inset: 0;
  padding: 4px 0 0;
  opacity: 0;
  pointer-events: none;
  transform: translateX(12px);
  transition: opacity 0.2s ease, transform 0.2s ease;
  overflow-y: auto;
  scrollbar-width: thin;
}

#o4-premium-{{ section.id }} .cdm__panel.is-active {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(0);
}

#o4-premium-{{ section.id }} .cdm__panel[data-cdm-panel="root"] {
  min-height: 0;
}

@media (min-width: 960px) {
  #o4-premium-{{ section.id }} .cdm__panels {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
    gap: 12px;
    min-height: 0;
  }

  #o4-premium-{{ section.id }} .cdm__panel {
    position: relative;
    inset: auto;
    opacity: 1;
    pointer-events: auto;
    transform: none;
    transition: none;
    height: 100%;
    min-height: 0;
  }

  #o4-premium-{{ section.id }} .cdm__panel[data-cdm-panel="root"] {
    display: block;
    padding-right: 12px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  #o4-premium-{{ section.id }} .cdm__panel:not([data-cdm-panel="root"]) {
    display: none;
  }

  #o4-premium-{{ section.id }} .cdm__panel.is-active:not([data-cdm-panel="root"]) {
    display: block;
  }

  #o4-premium-{{ section.id }} .cdm__back {
    display: none;
  }
}

#o4-premium-{{ section.id }} .cdm__panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: linear-gradient(120deg, rgba(9, 15, 28, 0.88), rgba(4, 7, 16, 0.92));
  font-family: var(--font-heading);
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.75rem;
  color: rgba(214, 245, 255, 0.85);
  text-shadow: 0 0 14px rgba(0, 255, 255, 0.25);
}

#o4-premium-{{ section.id }} .cdm__panel-title {
  line-height: 1;
}

#o4-premium-{{ section.id }} .cdm__back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
}

#o4-premium-{{ section.id }} .cdm__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}

#o4-premium-{{ section.id }} .cdm__row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass-soft);
  color: var(--menu-muted);
  font-size: 1.02rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
}

#o4-premium-{{ section.id }} .cdm__label {
  flex: 1 1 auto;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#o4-premium-{{ section.id }} .cdm__row-icon {
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  color: rgba(190, 245, 255, 0.9);
  flex: 0 0 auto;
}

#o4-premium-{{ section.id }} .cdm__row-icon svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

#o4-premium-{{ section.id }} .cdm__row-chevron {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
}

#o4-premium-{{ section.id }} .cdm__row-chevron svg {
  width: 18px;
  height: 18px;
  stroke-width: 2;
  opacity: 0.6;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

#o4-premium-{{ section.id }} .cdm__row:hover,
#o4-premium-{{ section.id }} .cdm__row:focus-visible {
  color: var(--menu-text);
  border-color: rgba(47, 228, 212, 0.22);
  background: linear-gradient(90deg, rgba(47, 228, 212, 0.14), rgba(255, 255, 255, 0.02));
  box-shadow: 0 0 0 1px rgba(47, 228, 212, 0.12) inset, 0 10px 24px rgba(0, 0, 0, 0.35), 0 0 26px rgba(47, 228, 212, 0.14);
  transform: translateY(-1px);
}

#o4-premium-{{ section.id }} .cdm__row:hover .cdm__row-chevron svg,
#o4-premium-{{ section.id }} .cdm__row:focus-visible .cdm__row-chevron svg {
  opacity: 0.9;
  transform: translateX(2px);
}

#o4-premium-{{ section.id }} .cdm__row.is-active,
#o4-premium-{{ section.id }} .cdm__row[aria-expanded="true"] {
  color: var(--menu-text);
  border-color: rgba(47, 228, 212, 0.35);
  background: linear-gradient(90deg, rgba(47, 228, 212, 0.22), rgba(106, 60, 240, 0.06));
  box-shadow: 0 0 0 1px rgba(47, 228, 212, 0.18) inset, 0 0 28px rgba(47, 228, 212, 0.18);
}

#o4-premium-{{ section.id }} .cdm__row.is-sale {
  color: rgba(199, 125, 255, 0.9);
}

#o4-premium-{{ section.id }} .cdm__row.is-sale .cdm__row-icon {
  color: rgba(199, 125, 255, 0.9);
}

#o4-premium-{{ section.id }} .cdm__row.is-sale:hover,
#o4-premium-{{ section.id }} .cdm__row.is-sale:focus-visible {
  color: #e2b3ff;
  border-color: rgba(106, 60, 240, 0.35);
  background: linear-gradient(90deg, rgba(106, 60, 240, 0.18), rgba(255, 255, 255, 0.02));
  box-shadow: 0 0 24px rgba(106, 60, 240, 0.2);
}

#o4-premium-{{ section.id }} .cdm__empty {
  padding: 16px;
  color: #94a3b8;
  font-size: 0.95rem;
}

#o4-premium-{{ section.id }} .cdm__trigger {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 999px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass);
  color: var(--menu-text);
  font-family: var(--font-heading);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

#o4-premium-{{ section.id }} .cdm__trigger svg {
  width: 18px;
  height: 18px;
  stroke-width: 2;
}

#o4-premium-{{ section.id }} .cdm__trigger:hover,
#o4-premium-{{ section.id }} .cdm__trigger:focus-visible {
  border-color: rgba(47, 228, 212, 0.35);
  box-shadow: 0 0 16px rgba(47, 228, 212, 0.25);
