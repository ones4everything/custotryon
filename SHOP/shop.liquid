/* --- BOTTOM NAV --- */
#o4-premium-{{ section.id }} .o4-bottom-nav {
  position: fixed;
  left: 50%;
  bottom: 16px;
  transform: translateX(-50%);
  width: min(820px, calc(100% - 24px));
  z-index: 9980;
  pointer-events: none;
}

#o4-premium-{{ section.id }} .o4-bottom-nav::before {
  content: "";
  position: absolute;
  inset: -12px;
  border-radius: 999px;
  background: radial-gradient(circle at center, rgba(47, 228, 212, 0.4), transparent 70%);
  filter: blur(16px);
  opacity: 0.65;
  pointer-events: none;
}

#o4-premium-{{ section.id }} .o4-bottom-nav-inner {
  pointer-events: auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 20px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(4, 10, 18, 0.92), rgba(6, 14, 26, 0.92));
