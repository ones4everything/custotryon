{% assign menu_links = section.settings.menu.links %}
{% if menu_links == blank and linklists['shop'] != blank %}
  {% assign menu_links = linklists['shop'].links %}
{% endif %}
{% assign active_collection = section.settings.collection %}
{% if active_collection == blank and collection %}
  {% assign active_collection = collection %}
{% endif %}
{% if active_collection %}
  {% assign heading_title = active_collection.title | default: section.settings.title %}
{% else %}
  {% assign heading_title = section.settings.title %}
{% endif %}
{% assign active_menu = nil %}
{% if menu_links != blank %}
  {% for link in menu_links %}
    {% if link.active or link.child_active %}
      {% assign active_menu = link %}
    {% endif %}
  {% endfor %}
  {% if active_menu == nil %}
    {% assign active_menu = menu_links[0] %}
  {% endif %}
{% endif %}
{% assign active_menu_key = '' %}
{% if active_menu %}
  {% assign active_menu_key = active_menu.title | handleize %}
{% endif %}

{% assign shop_url = routes.collections_url %}
{% assign category_title = blank %}
{% assign category_url = blank %}
{% assign subcat_title = blank %}
{% assign subcat_url = blank %}

{% if template.name == 'product' and product %}
  {% assign primary_collection = product.collections.first %}
  {% if primary_collection %}
    {% assign category_title = primary_collection.title %}
    {% assign category_url = primary_collection.url %}
    {% if category_title contains ' - ' %}
      {% assign parts = category_title | split: ' - ' %}
      {% if parts.size >= 2 %}
        {% assign category_title = parts[0] | strip %}
        {% assign subcat_title = parts[1] | strip %}
        {% assign subcat_url = primary_collection.url %}
      {% endif %}
    {% elsif category_title contains ' / ' %}
      {% assign parts = category_title | split: ' / ' %}
      {% if parts.size >= 2 %}
        {% assign category_title = parts[0] | strip %}
        {% assign subcat_title = parts[1] | strip %}
        {% assign subcat_url = primary_collection.url %}
      {% endif %}
    {% endif %}
  {% endif %}
{% elsif template.name == 'collection' and collection %}
  {% assign category_title = collection.title %}
  {% assign category_url = collection.url %}
  {% if category_title contains ' - ' %}
    {% assign parts = category_title | split: ' - ' %}
    {% if parts.size >= 2 %}
      {% assign category_title = parts[0] | strip %}
      {% assign subcat_title = parts[1] | strip %}
      {% assign subcat_url = collection.url %}
    {% endif %}
  {% elsif category_title contains ' / ' %}
    {% assign parts = category_title | split: ' / ' %}
    {% if parts.size >= 2 %}
      {% assign category_title = parts[0] | strip %}
      {% assign subcat_title = parts[1] | strip %}
      {% assign subcat_url = collection.url %}
    {% endif %}
  {% endif %}
{% endif %}

<section id="o4-premium-{{ section.id }}">
  <div class="o4-bg-radial"></div>

  <div class="o4-shell">
    <div class="cdm" data-cdm-root>
      <div class="cdm__scrim" data-cdm-scrim hidden></div>

      <aside class="cdm__drawer" data-cdm-drawer aria-hidden="true" role="dialog" aria-modal="true" id="cdm-drawer-{{ section.id }}">
        <div class="cdm__frame">
          <div class="cdm__header">
            <div class="cdm__title">{{ section.settings.menu_title | default: "Shop" }}</div>
            <div class="cdm__actions">
              <a href="{{ routes.cart_url }}" class="cdm__icon-btn" aria-label="Cart">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <circle cx="9" cy="20" r="1"></circle>
                  <circle cx="17" cy="20" r="1"></circle>
                  <path d="M5 5h2l2 10h9l2-7H8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
              {% if customer %}
                <a href="{{ routes.account_url }}" class="cdm__icon-btn" aria-label="Account">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 20c2.5-4 13.5-4 16 0" stroke-linecap="round"></path>
                  </svg>
                </a>
              {% else %}
                <a href="{{ routes.account_login_url }}" class="cdm__icon-btn" aria-label="Sign in">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 20c2.5-4 13.5-4 16 0" stroke-linecap="round"></path>
                  </svg>
                </a>
              {% endif %}
              <button class="cdm__close" type="button" data-cdm-close aria-label="Close menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M6 6l12 12" stroke-linecap="round"></path>
                  <path d="M18 6l-12 12" stroke-linecap="round"></path>
                </svg>
              </button>
            </div>
          </div>

          <form class="cdm__search" action="{{ routes.search_url }}" method="get" role="search" data-voice-form>
            <span class="cdm__search-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
              </svg>
            </span>
            <input class="cdm__search-input"
                   type="search"
                   name="q"
                   placeholder="Search product or brand"
                   aria-label="Search products"
                   data-voice-input>
            <button class="cdm__voice-btn" type="button" data-voice-btn aria-label="Start voice search" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="M12 3a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <path d="M12 19v3"></path>
                <path d="M8 22h8"></path>
              </svg>
            </button>
            <span class="cdm__voice-status" data-voice-status aria-live="polite"></span>
          </form>

          {% if category_title != blank %}
            <nav class="cdm__crumbs" aria-label="Breadcrumb">
              <div class="cdm__crumbs-inner" role="list">
                <a class="cdm__crumbs-link" href="{{ shop_url }}" role="listitem">shop</a>
                <span class="cdm__crumbs-sep" aria-hidden="true">/</span>
                <a class="cdm__crumbs-link" href="{{ category_url }}" role="listitem">{{ category_title }}</a>
                <span class="cdm__crumbs-sep" aria-hidden="true">/</span>
                {% if subcat_title != blank and subcat_url != blank %}
                  <a class="cdm__crumbs-link" href="{{ subcat_url }}" role="listitem">{{ subcat_title }}</a>
                  <span class="cdm__crumbs-sep" aria-hidden="true">/</span>
                {% endif %}
              </div>
            </nav>
          {% endif %}

          <div class="cdm__panels" data-cdm-panels>
            <section class="cdm__panel is-active" data-cdm-panel="root" aria-label="Shop categories" aria-hidden="false">
              <ul class="cdm__list">
                {% if menu_links != blank %}
                  {% for link in menu_links %}
                    {% assign menu_key = link.title | handleize %}
                    {% assign panel_id = 'cdm-panel-' | append: section.id | append: '-' | append: menu_key %}
                    {% assign link_title_lower = link.title | downcase %}
                    {% assign icon_type = 'grid' %}
                    {% if link_title_lower contains 'shirt' %}
                      {% assign icon_type = 'shirt' %}
                    {% elsif link_title_lower contains 'hood' %}
                      {% assign icon_type = 'hoodie' %}
                    {% elsif link_title_lower contains 'short' %}
                      {% assign icon_type = 'shorts' %}
                    {% elsif link_title_lower contains 'pant' or link_title_lower contains 'jean' or link_title_lower contains 'bottom' %}
                      {% assign icon_type = 'pants' %}
                    {% elsif link_title_lower contains 'shoe' or link_title_lower contains 'sneaker' %}
                      {% assign icon_type = 'shoe' %}
                    {% elsif link_title_lower contains 'hat' or link_title_lower contains 'cap' %}
                      {% assign icon_type = 'hat' %}
                    {% elsif link_title_lower contains 'bag' %}
                      {% assign icon_type = 'bag' %}
                    {% elsif link_title_lower contains 'accessor' or link_title_lower contains 'jewel' %}
                      {% assign icon_type = 'spark' %}
                    {% elsif link_title_lower contains 'care' or link_title_lower contains 'beauty' %}
                      {% assign icon_type = 'drop' %}
                    {% elsif link_title_lower contains 'electronic' or link_title_lower contains 'tech' %}
                      {% assign icon_type = 'bolt' %}
                    {% elsif link_title_lower contains 'sale' or link_title_lower contains 'clear' %}
                      {% assign icon_type = 'tag' %}
                    {% elsif link_title_lower contains 'cloth' %}
                      {% assign icon_type = 'shirt' %}
                    {% endif %}
                    <li class="cdm__item">
                      {% if link.links != blank %}
                        <button type="button"
                                class="cdm__row{% if menu_key == active_menu_key %} is-active{% endif %}{% if link_title_lower contains 'sale' %} is-sale{% endif %}"
                                data-cdm-next
                                data-cdm-target="{{ menu_key }}"
                                aria-controls="{{ panel_id }}"
                                aria-haspopup="true"
                                aria-expanded="false">
                          <span class="cdm__row-icon" aria-hidden="true">
                            {% case icon_type %}
                              {% when 'shirt' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                  <path d="M8 5l4-2 4 2 3 2-2 4-2-1v11H9V10l-2 1-2-4 3-2z"></path>
                                </svg>
                              {% when 'hoodie' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                  <path d="M7 9a5 5 0 0 1 10 0v3l-2 2v7H9v-7l-2-2V9z"></path>
                                  <path d="M9 21v-7a3 3 0 0 1 6 0v7"></path>
                                  <path d="M10 12h4"></path>
                                </svg>
                              {% when 'shorts' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                  <path d="M7 4h10l-1 8-4-2-4 2-1-8z"></path>
                                  <path d="M6 20h5l1-8"></path>
                                  <path d="M18 20h-5l-1-8"></path>
                                </svg>
                              {% when 'pants' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                  <path d="M8 3h8l-1 18h-4l-1-9-1 9H5L8 3z"></path>
                                </svg>
                              {% when 'shoe' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                  <path d="M3 14c4 0 6-2 8-4l3 3c2 2 5 3 7 3v3H3v-2z"></path>
                                  <path d="M11 10l2-2"></path>
                                </svg>
                              {% when 'hat' %}
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                                  <path d="M4 13c2-4 14-4 16 0"></path>
                                  <path d="M6 13v4a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-4"></path>
                                  <path d="M8 8a4 4 0 0 1 8 0"></path>
