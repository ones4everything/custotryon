  margin: 0 0 40px;
  flex-wrap: wrap;
}

#o4-premium-{{ section.id }} .o4-min-toggle {
  margin-left: auto;
  display: grid;
  gap: 4px;
  justify-items: start;
}

#o4-premium-{{ section.id }} .o4-min-toggle__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid var(--menu-line);
  background: var(--menu-glass);
  color: var(--menu-text);
  font-family: var(--font-heading);
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  cursor: pointer;
